{
  "name": "saigon-tour",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "conc -k 'bun:dev:*'",
    "dev:client": "bun run --filter '@saigon/client' dev",
    "dev:server": "bun run --filter '@saigon/server' dev",
    "check": "biome check .",
    "check:types": "tsgo -b",
    "build": "bun run --filter '@saigon/client' build && bun run --filter '@saigon/server' build",
    "test": "bun run --filter '@saigon/server' test && bun run --filter '@saigon/client' test",
    "prepare:assets": "bun scripts/prepare-assets.ts",
    "preview": "bun run --filter '@saigon/client' preview"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "concurrently": "^10.0.6",
    "meshoptimizer": "1.1.1",
    "sharp": "0.35.5",
    "typescript": "7.0.2"
  }
}
