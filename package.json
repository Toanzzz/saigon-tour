{
  "name": "saigon-tour",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run db:up && conc -k --kill-timeout 3000 'bun:dev:*'",
    "dev:client": "bun run --filter '@saigon/client' dev",
    "dev:server": "bun run --filter '@saigon/server' dev",
    "check": "biome check .",
    "check:types": "bun run --filter '@saigon/client' i18n:compile && tsc -b",
    "build": "bun run --filter '@saigon/client' build && bun run --filter '@saigon/server' build",
    "test": "bun run --filter '@saigon/server' test && bun run --filter '@saigon/client' test",
    "prepare:assets": "bun scripts/prepare-assets.ts",
    "credentials": "bun scripts/credentials.ts",
    "preview": "bun run --filter '@saigon/client' preview",
    "db:up": "docker compose up -d --wait db",
    "test:integration": "bun run --filter @saigon/server test:integration"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/draco3d": "^1.4.10",
    "concurrently": "^10.0.6",
    "draco3d": "1.5.9",
    "sharp": "0.35.5",
    "typescript": "7.0.2"
  }
}
