    "conversations": [
      {
        "id": "mai",
        "lines": [
          "MaiChào buổi sáng! Pull",
          "MaiAh, gu giống tôi đó! For coffee, try cà phê sữa đá slow-drip right here in the shade. For architecture, walk Lê Lợi to Nguyễn Huệ — Tòa Thị Chính and the Opera House in the morning light, then the Post Office for a postcard. Mời bạn ngồi!"
        ],
        "source": "Live NPC conversation"
      },
      {
        "id": "alex",
        "lines": [
          "AlexChào buổi sáng! Beautiful light on the Opera House today, right? Look at how the morning sun hits those columns — what detail catches your eye first?",
          "AlexOh, cùng sở thích! Notice the Opera House columns and arches up close, then wander Đồng Khởi shops for lovely façades. Grab cà phê sữa đá and people-watch — can you spot the carved details above the doors?"
        ],
        "source": "Live NPC conversation"
      }
    ]
