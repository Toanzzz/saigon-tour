{
  "name": "@saigon/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target=node --outdir=dist",
    "start": "node dist/index.js",
    "check:types": "tsgo -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.71",
    "@hono/node-server": "2.1.5",
    "@mastra/core": "1.80.0",
    "@mastra/memory": "1.39.1",
    "@saigon/shared": "workspace:*",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "vitest": "5.0.5"
  }
}
