# Copy to the repository root `.env` for local overrides. Never commit real values.
DATABASE_URL=postgres://saigon:saigon@127.0.0.1:58002/saigon
META_MUSE_API_KEY=
# Better Auth: 32+ random characters, required in production.
BETTER_AUTH_SECRET=
# Browser-visible API base (auth callbacks resolve under `${PUBLIC_API_URL}/auth`).
PUBLIC_API_URL=http://127.0.0.1:58000/api
CLIENT_URL=http://127.0.0.1:58000
CORS_ORIGINS=http://localhost:58000,http://127.0.0.1:58000
# Meta login (Facebook Login). Set both to enable; redirect URI: ${PUBLIC_API_URL}/auth/callback/facebook
META_CLIENT_ID=
META_CLIENT_SECRET=

# City Director: live uses the model with scripted fallback; scripted is deterministic.
DIRECTOR_MODE=live
DIRECTOR_DAILY_LIMIT=200
