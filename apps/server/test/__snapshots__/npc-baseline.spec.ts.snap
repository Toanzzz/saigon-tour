  "linh": {
    "en": [
      {
        "description": "I am appointing you Deputy Invitations Officer. Report to the market, recruit Cô Hoa to the committee, then deliver this invitation postcard to Mai for the neighborhood lunch.",
        "giverNpcId": "linh",
        "payoff": "Thảo has the invitation! Thank you. You are officially Head of Invitations; this neighborhood lunch has its entertainment now.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "market",
            "type": "GO_TO",
          },
          {
            "npcId": "hoa",
            "type": "TALK_TO",
          },
          {
            "itemId": "postcard",
            "npcId": "mai",
            "type": "DELIVER",
          },
        ],
        "title": "Deputy Invitations Officer",
        "twist": {
          "line": "Hoa: Mai is not on the guest list — she is the guest list. Give the invite to Thao; she runs entertainment.",
          "step": {
            "itemId": "postcard",
            "npcId": "thao",
            "type": "DELIVER",
          },
        },
      },
      {
        "description": "I am appointing you Deputy Herb Logistics Officer. Your first duty: deliver these herbs to Cô Hoa at the market. Badge pending.",
        "giverNpcId": "linh",
        "payoff": "The herbs reached Cô Hoa! Thank you for the flawless logistics. Senior Deputy Herb Logistics Officer has a nice ring, does it not?",
        "scope": "solo",
        "steps": [
          {
            "itemId": "herbs",
            "npcId": "hoa",
            "type": "DELIVER",
          },
        ],
        "title": "Deputy Herb Logistics Officer",
      },
      {
        "description": "Visit the market and invite Ms. Hoa to our neighborhood lunch.",
        "giverNpcId": "linh",
        "payoff": "You brought the lunch invitation to Cô Hoa! Thank you. One more neighbor at the table makes the whole lunch feel warmer.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "market",
            "type": "GO_TO",
          },
          {
            "npcId": "hoa",
            "type": "TALK_TO",
          },
        ],
        "title": "A community lunch invitation",
      },
    ],
    "vi": [
      {
        "description": "Chị phong em làm Phó ban Thư mời. Ra chợ, mời Cô Hoa vào ban tổ chức, rồi mang tấm bưu thiếp mời này giao cho Mai cho bữa trưa của xóm nghen.",
        "giverNpcId": "linh",
        "payoff": "Thảo nhận thư mời rồi! Cảm ơn bạn nha. Chính thức thăng làm Trưởng ban Thư mời luôn; bữa trưa xóm mình có văn nghệ rồi.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "market",
            "type": "GO_TO",
          },
          {
            "npcId": "hoa",
            "type": "TALK_TO",
          },
          {
            "itemId": "postcard",
            "npcId": "mai",
            "type": "DELIVER",
          },
        ],
        "title": "Phó ban Thư mời",
        "twist": {
          "line": "Hoa: Mai đâu nằm trong danh sách khách — Mai chính là danh sách khách đó. Đưa thư mời cho Thảo đi, Thảo lo văn nghệ.",
          "step": {
            "itemId": "postcard",
            "npcId": "thao",
            "type": "DELIVER",
          },
        },
      },
      {
        "description": "Chị bổ nhiệm bạn làm Phó phòng Hậu cần Rau thơm. Nhiệm vụ đầu tiên: mang rau thơm này cho Cô Hoa ở chợ. Huy hiệu sẽ có sau.",
        "giverNpcId": "linh",
        "payoff": "Rau thơm tới cô Hoa rồi! Cảm ơn bạn lo hậu cần chu đáo nha. Phó phòng Cấp cao Hậu cần Rau thơm nghe cũng oai ha?",
        "scope": "solo",
        "steps": [
          {
            "itemId": "herbs",
            "npcId": "hoa",
            "type": "DELIVER",
          },
        ],
        "title": "Phó phòng Hậu cần Rau thơm",
      },
      {
        "description": "Ghé chợ và mời cô Hoa đến bữa trưa chung của xóm.",
        "giverNpcId": "linh",
        "payoff": "Bạn mang lời mời ăn trưa tới cô Hoa rồi! Cảm ơn nha. Thêm một người cùng bàn là bữa trưa ấm hơn hẳn.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "market",
            "type": "GO_TO",
          },
          {
            "npcId": "hoa",
            "type": "TALK_TO",
          },
        ],
        "title": "Lời mời ăn trưa của xóm",
      },
    ],
  },
  "mai": {
    "en": [
      {
        "description": "First, a banana from the market as a palate cleanser. Then check in with Cô Hoa and hand her this cà phê sữa đá. Tasting notes: caramel, morning market, and a brave little bitterness.",
        "giverNpcId": "mai",
        "payoff": "Sơn has the coffee. Thank you! Tasting notes: a good detour and a reviewer who may write a whole postcard about it.",
        "scope": "solo",
        "steps": [
          {
            "marketItemId": "banana",
            "type": "BUY",
          },
          {
            "npcId": "hoa",
            "type": "TALK_TO",
          },
          {
            "itemId": "coffee",
            "npcId": "hoa",
            "type": "DELIVER",
          },
        ],
        "title": "Tasting notes: a palate cleanser",
        "twist": {
          "line": "Hoa: con, I am a pho person, not a coffee person. Give it to Son — he reviews everything.",
          "step": {
            "itemId": "coffee",
            "npcId": "son",
            "type": "DELIVER",
          },
        },
      },
      {
        "description": "Carry this cà phê sữa đá to Cô Hoa. Tasting notes: caramel, a hint of afternoon rain, and quiet ambition. Do not shake the ambition out.",
        "giverNpcId": "mai",
        "payoff": "Cô Hoa has her cà phê sữa đá. Thank you! The ambition made it across the market; the honest review is up to her.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "coffee",
            "npcId": "hoa",
            "type": "DELIVER",
          },
        ],
        "title": "Tasting notes: caramel, rain, ambition",
      },
      {
        "description": "Take this coffee across the market to Ms. Hoa.",
        "giverNpcId": "mai",
        "payoff": "Cô Hoa has her coffee. Thank you! Tasting notes: a little sweetness, a busy market, and a very kind delivery.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "coffee",
            "npcId": "hoa",
            "type": "DELIVER",
          },
        ],
        "title": "Coffee for Ms. Hoa",
      },
    ],
    "vi": [
      {
        "description": "Trước hết, mua một trái chuối ngoài chợ để súc miệng cái đã. Rồi ghé Cô Hoa và đưa cô ly cà phê sữa đá này. Hương vị: caramel, chợ sớm, và một chút đắng gan lì.",
        "giverNpcId": "mai",
        "payoff": "Sơn nhận cà phê rồi. Cảm ơn bạn nha! Hương vị: một chuyến đổi đường hay ho, gặp người có khi viết cả bưu thiếp để bình ly này.",
        "scope": "solo",
        "steps": [
          {
            "marketItemId": "banana",
            "type": "BUY",
          },
          {
            "npcId": "hoa",
            "type": "TALK_TO",
          },
          {
            "itemId": "coffee",
            "npcId": "hoa",
            "type": "DELIVER",
          },
        ],
        "title": "Hương vị: món súc miệng",
        "twist": {
          "line": "Hoa: con ơi, cô là người của phở chớ đâu phải cà phê. Đưa cho Sơn đi — cái gì nó cũng chấm điểm hết.",
          "step": {
            "itemId": "coffee",
            "npcId": "son",
            "type": "DELIVER",
          },
        },
      },
      {
        "description": "Mang ly cà phê sữa đá này tới Cô Hoa. Hương vị: caramel, chút mưa chiều, và một ít hoài bão lặng lẽ. Đừng lắc rớt hoài bão nha.",
        "giverNpcId": "mai",
        "payoff": "Cô Hoa có cà phê sữa đá rồi. Cảm ơn bạn nha! Chút hoài bão đã qua tới bên kia chợ; còn nhận xét thành thật thì để cô.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "coffee",
            "npcId": "hoa",
            "type": "DELIVER",
          },
        ],
        "title": "Hương vị: caramel, mưa, hoài bão",
      },
      {
        "description": "Mang ly cà phê này qua chợ cho cô Hoa.",
        "giverNpcId": "mai",
        "payoff": "Cô Hoa nhận cà phê rồi. Cảm ơn bạn nha! Hương vị: một chút ngọt, một buổi chợ đông, một người giao dễ thương.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "coffee",
            "npcId": "hoa",
            "type": "DELIVER",
          },
        ],
        "title": "Cà phê cho cô Hoa",
      },
    ],
  },
