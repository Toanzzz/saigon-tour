  "ba": {
    "en": [
      {
        "description": "This old photo has a story, and the story drifts. Walk to the opera, let Alex look it over, then carry the photo to Son. The moral, as always, is about something else.",
        "giverNpcId": "ba",
        "payoff": "The old photo is with Tâm now. Thank you, cháu. A picture finding its way home is a fine ending to one of my wandering stories.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "opera",
            "type": "GO_TO",
          },
          {
            "npcId": "alex",
