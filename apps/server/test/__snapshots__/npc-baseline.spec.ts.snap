  "plaza-stroll": {
    "en": [
      {
        "description": "I have penned a single trembling verse on this postcard, bạn. Carry it to anh Alex at the Opera House and, when you hand it over, deliver the line out loud — gently, like the lamps are listening.",
        "giverNpcId": "plaza-stroll",
        "payoff": "Alex clapped at your line, bạn? Then the verse found its stage. Bravo — encore tomorrow.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "postcard",
            "npcId": "alex",
            "type": "DELIVER",
          },
        ],
        "title": "Deliver the line",
      },
      {
        "description": "Bring this photo to chị Vy at City Hall.",
        "giverNpcId": "plaza-stroll",
        "scope": "solo",
        "steps": [
          {
            "itemId": "photo",
            "npcId": "vy",
            "type": "DELIVER",
          },
        ],
        "title": "A keepsake for a neighbor",
      },
    ],
    "vi": [
      {
        "description": "Mình đã đề một câu ngâm run run lên tấm bưu thiếp này, bạn ơi. Mang qua cho anh Alex ở Nhà hát, và khi trao thì xuống câu thành tiếng — nhẹ thôi, như thể đèn đang lắng nghe.",
        "giverNpcId": "plaza-stroll",
        "payoff": "Anh Alex vỗ tay khi bạn xuống câu hả? Vậy là câu ngâm đã tìm được sân khấu. Hoan hô — mai diễn lại nhé.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "postcard",
            "npcId": "alex",
            "type": "DELIVER",
          },
        ],
        "title": "Xuống câu giùm nhé",
      },
      {
        "description": "Mang tấm ảnh này đến cho chị Vy ở Tòa Thị Chính.",
        "giverNpcId": "plaza-stroll",
        "scope": "solo",
        "steps": [
          {
            "itemId": "photo",
            "npcId": "vy",
            "type": "DELIVER",
          },
        ],
        "title": "Kỷ vật cho hàng xóm",
      },
    ],
  },
  "postcard-reader": {
    "en": [
      {
        "description": "I inked a haiku beside the stamp, bạn: blue stamp, patient glue / a small boat waits for the tide / carry it to shore. Take the postcard to anh Sơn at the post office.",
        "giverNpcId": "postcard-reader",
        "payoff": "Sơn read the haiku aloud, bạn? Then the little boat reached shore. The stamp may retire, satisfied.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "postcard",
            "npcId": "son",
            "type": "DELIVER",
          },
        ],
        "title": "A haiku for the stamp",
      },
      {
        "description": "Bring this photo to chị Vy at City Hall.",
        "giverNpcId": "postcard-reader",
        "scope": "solo",
        "steps": [
          {
            "itemId": "photo",
            "npcId": "vy",
            "type": "DELIVER",
          },
        ],
        "title": "A photo for City Hall",
      },
      {
        "description": "A haiku for a hidden address. Work out who receives this postcard, or let a neighbor or a cyclo tell you.",
        "giverNpcId": "postcard-reader",
        "payoff": "Delivered to the right poet. Stamp, address, and riddle: all three finally rhyme.",
        "riddle": {
          "text": "Carry this card to the neighbor who mails letters to the river and never waits for a reply. He will know the stamp.",
        },
        "scope": "solo",
        "steps": [
          {
            "itemId": "postcard",
            "npcId": "son",
            "type": "DELIVER",
          },
        ],
        "title": "A stamp-poem riddle",
      },
    ],
    "vi": [
      {
        "description": "Mình đề một bài haiku cạnh con tem, bạn ơi: tem xanh, keo kiên nhẫn / con thuyền nhỏ đợi con nước lên / mang tới bến giùm. Đưa tấm bưu thiếp cho anh Sơn ở bưu điện nhé.",
        "giverNpcId": "postcard-reader",
        "payoff": "Anh Sơn đọc bài haiku lên hả bạn? Vậy là con thuyền nhỏ đã tới bến. Con tem giờ có thể an lòng nghỉ hưu.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "postcard",
            "npcId": "son",
            "type": "DELIVER",
          },
        ],
        "title": "Bài haiku cho con tem",
      },
      {
        "description": "Mang tấm ảnh này đến cho chị Vy ở Tòa Thị Chính.",
        "giverNpcId": "postcard-reader",
        "scope": "solo",
        "steps": [
          {
            "itemId": "photo",
            "npcId": "vy",
            "type": "DELIVER",
          },
        ],
        "title": "Tấm ảnh cho Tòa Thị Chính",
      },
      {
        "description": "Một bài haiku cho địa chỉ còn giấu. Đoán xem ai nhận tấm bưu thiếp này, hoặc để hàng xóm hay bác xích lô mách cho.",
        "giverNpcId": "postcard-reader",
        "payoff": "Giao đúng cho nhà thơ rồi. Con tem, địa chỉ, và câu đố: cuối cùng cả ba cũng vần.",
        "riddle": {
          "text": "Mang tấm thiệp này đến người hàng xóm hay gửi thư cho dòng sông mà chẳng bao giờ chờ hồi âm. Anh ấy sẽ biết con tem.",
        },
        "scope": "solo",
        "steps": [
          {
            "itemId": "postcard",
            "npcId": "son",
            "type": "DELIVER",
          },
        ],
        "title": "Câu đố thơ con tem",
      },
    ],
  },
  "river-jogger": {
    "en": [
      {
        "description": "Quick — bạn — take this — banana — to bác Ba — by the river. But keep pace, do not — slow down, or it — counts as a — rest day. Go, go.",
        "giverNpcId": "river-jogger",
        "payoff": "Bác Ba — got it — and you — kept pace? Then today — is not — a rest day. Huff — nice work, bạn.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "banana",
            "npcId": "ba",
            "type": "DELIVER",
          },
        ],
        "title": "Keep pace with the banana",
      },
      {
        "description": "Bring these herbs to chị Linh in the park.",
        "giverNpcId": "river-jogger",
        "scope": "solo",
        "steps": [
          {
            "itemId": "herbs",
            "npcId": "linh",
            "type": "DELIVER",
