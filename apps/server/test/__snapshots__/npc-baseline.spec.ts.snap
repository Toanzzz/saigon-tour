  "son": {
    "en": [
      {
        "description": "I wrote a postcard. It opens, "Dear River, you looked tired today." Walk to the river, ask Ong Ba to hear it out, then carry the postcard to Mai.",
        "giverNpcId": "son",
        "payoff": "Thảo has the postcard for the river. Thank you for finding it a voice. Dear River: a song is on its way. Warmly, Sơn.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "river",
            "type": "GO_TO",
          },
          {
            "npcId": "ba",
