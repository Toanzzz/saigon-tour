  "QUEST_SEEDS": [
    {
      "giverNpcId": "alex",
      "payoff": {
        "en": "You found my backdrop! Thanks for following the light with me. A hint or a happy guess, that frame is yours now.",
        "vi": "Bạn tìm được phông nền rồi! Cảm ơn đã cùng mình lần theo ánh sáng nha. Nhờ gợi ý hay đoán trúng thì khung hình này cũng là của bạn.",
      },
      "riddle": {
        "text": {
          "en": "Velvet curtains, a grand staircase, and a façade that poses for every photo. Even latecomers get reviewed here. Find the stage.",
          "vi": "Rèm nhung, bậc thang bề thế, mặt tiền lúc nào cũng tạo dáng cho ảnh. Tới trễ cũng bị chấm điểm. Tìm sân khấu đó đi.",
        },
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "opera",
          "type": "GO_TO",
        },
      ],
      "text": {
        "en": {
          "description": "I set the best backdrop in town as a riddle. Work out where it stands, or let a neighbor or a cyclo give it away.",
          "title": "A riddle worth a frame",
        },
        "vi": {
          "description": "Mình biến phông nền đẹp nhất phố thành câu đố. Đoán xem nó ở đâu, hoặc để hàng xóm hay bác xích lô bật mí.",
          "title": "Câu đố đáng một khung hình",
        },
      },
    },
    {
      "giverNpcId": "alex",
      "payoff": {
        "en": "You found the light across the cathedral square! Thanks for looking with me. The city always gives us another angle.",
        "vi": "Bạn tìm được ánh sáng ngoài quảng trường nhà thờ rồi! Cảm ơn đã cùng mình ngắm nha. Thành phố lúc nào cũng cho thêm một góc nhìn.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "cathedral",
          "type": "GO_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Visit the cathedral square and find the afternoon light.",
          "title": "Light across the square",
        },
        "vi": {
          "description": "Ghé quảng trường nhà thờ và tìm ánh nắng buổi chiều.",
          "title": "Ánh sáng qua quảng trường",
        },
      },
    },
    {
      "giverNpcId": "alex",
      "payoff": {
        "en": "Ông Ba has the cyclo photo! Thanks for helping it find the right home. The best part of the frame was waiting in the corner.",
        "vi": "Ông Ba nhận tấm hình xích lô rồi! Cảm ơn bạn giúp nó về đúng chỗ nha. Phần đẹp nhất của khung hình hóa ra chờ ngay trong góc.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "cathedral",
          "type": "GO_TO",
        },
        {
          "npcId": "son",
          "type": "TALK_TO",
        },
        {
          "itemId": "photo",
          "npcId": "vy",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "I am chasing the authentic shot. Scout the cathedral square for the light, ask Son what to frame, then deliver the photo to Vy before a pigeon photobombs the whole plan.",
          "title": "The authentic shot",
        },
        "vi": {
          "description": "Mình đang săn khung hình chân thật. Ra quảng trường nhà thờ tìm ánh sáng, hỏi Sơn nên chụp gì, rồi mang tấm hình giao cho Vy trước khi có con bồ câu nhảy vô phá khung hình.",
          "title": "Khung hình chân thật",
        },
      },
      "twist": {
        "line": {
          "en": "Son: the best subject is the cyclo in the corner, and it is Ba’s. The photo belongs to him.",
          "vi": "Sơn: chủ thể đẹp nhất là chiếc xích lô ở góc hình kìa, mà nó là của ông Ba. Tấm hình này phải đưa ông mới đúng.",
        },
        "step": {
          "itemId": "photo",
          "npcId": "ba",
          "type": "DELIVER",
        },
      },
    },
    {
      "giverNpcId": "alex",
      "payoff": {
        "en": "Sơn has my Opera House photo. Thank you! Now the pigeon has an audience, and I have another reason to keep the accidental shots.",
        "vi": "Sơn nhận tấm hình Nhà hát rồi. Cảm ơn bạn nha! Bồ câu có khán giả, còn mình có thêm lý do giữ mấy tấm chụp tình cờ.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "photo",
          "npcId": "son",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring this photo to Sơn at the post office. It is my most authentic shot of the Opera House. There is a pigeon mid-blink in the corner. It completes it.",
          "title": "The authentic shot",
        },
        "vi": {
          "description": "Mang tấm ảnh này cho Sơn ở bưu điện. Đây là tấm Nhà hát chân thật nhất của mình. Góc ảnh có con bồ câu đang chớp mắt. Nó làm nên tấm hình.",
          "title": "Tấm ảnh chân thật",
        },
      },
    },
    {
      "giverNpcId": "alley-diner",
      "payoff": {
        "en": "Cô Hoa has the broth! Thank you, bạn. Nine-point-four for the recipe, ten for helping the judge reach the chef.",
        "vi": "Cô Hoa nhận nước lèo rồi! Cảm ơn bạn nha. Chín phẩy tư cho công thức, mười điểm cho người nối giám khảo với đầu bếp.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "broth",
          "npcId": "hoa",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "I scored this broth a nine-point-four, bạn: rich opening, strong finish. Take it to cô Hoa at the market so the judge can meet the chef — carefully, a spill drops it to a nine-point-one.",
          "title": "A nine-point-four broth",
        },
        "vi": {
          "description": "Mình chấm tô nước lèo này chín phẩy tư nè bạn: mở vị đậm, hậu mạnh. Mang qua cho cô Hoa ở chợ để giám khảo gặp đầu bếp — nhẹ tay thôi, đổ một giọt là rớt còn chín phẩy một.",
          "title": "Tô nước lèo chín phẩy tư",
        },
      },
    },
    {
      "giverNpcId": "alley-diner",
      "payoff": {
        "en": "Linh has the noodles for the park lunch! Thank you, bạn. A generous delivery with a lovely finish: ten points for sharing.",
        "vi": "Chị Linh có mì cho bữa trưa công viên rồi! Cảm ơn bạn nha. Giao hào phóng, hậu vị dễ thương: mười điểm chia sẻ.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "noodles",
          "npcId": "linh",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring these noodles to chị Linh in the park.",
          "title": "Noodles for the park lunch",
        },
        "vi": {
          "description": "Mang phần mì này đến cho chị Linh ở công viên.",
          "title": "Mì cho bữa trưa công viên",
        },
      },
    },
    {
      "giverNpcId": "alley-vendor",
      "payoff": {
        "en": "Linh got my hello! Thanks, bạn. The stove keeps me here, but a good neighbor can carry a little warmth all the way to the park.",
        "vi": "Chị Linh nhận lời chào rồi! Cảm ơn bạn nha. Chú vướng cái bếp ở đây, may có hàng xóm mang giùm chút ấm ra tận công viên.",
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Linh in the park for the alley cook, then return.",
          "title": "Mr. Loc's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến chị Linh ở công viên rồi quay lại nhé.",
          "title": "Lời nhắn của Chú Lộc",
        },
      },
    },
    {
      "giverNpcId": "ba",
      "payoff": {
        "en": "Sơn has the photo. Thank you, cháu, for carrying a little of the old city with you. The story about the fish can wait till you sit down.",
        "vi": "Sơn nhận hình rồi. Cảm ơn cháu đã mang giùm ông một chút Sài Gòn xưa. Chuyện con cá để lúc nào cháu ngồi chơi rồi ông kể.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "photo",
          "npcId": "son",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Take this old photo to Sơn by the post office. It reminds me of a fish I once lost, which taught me patience. Or was it the fish that was patient?",
          "title": "A photo and a moral",
        },
        "vi": {
          "description": "Mang tấm hình cũ này cho Sơn ở bưu điện giúp ông. Nó làm ông nhớ con cá ông từng vuột mất, dạy ông tính kiên nhẫn. Hay con cá mới là đứa kiên nhẫn ta?",
          "title": "Tấm hình và một bài học",
        },
      },
    },
    {
      "giverNpcId": "ba",
      "payoff": {
        "en": "You made it to the Opera House. Thank you for taking the walk, cháu. The city keeps a different story around every corner.",
        "vi": "Cháu ghé Nhà hát rồi. Cảm ơn đã chịu đi một vòng nha. Thành phố này, qua mỗi góc là có một câu chuyện khác.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "opera",
          "type": "GO_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Visit the Opera House and find another side of our city.",
          "title": "A view along the river",
        },
        "vi": {
          "description": "Ghé Nhà hát Thành phố và khám phá một góc khác của thành phố.",
          "title": "Ngắm cảnh dọc sông",
        },
      },
    },
    {
      "gift": "lanterns",
      "giverNpcId": "ba",
      "milestone": "evening-concert",
      "payoff": {
        "en": "Alex has returned the lantern frames for the concert. Thank you, cháu. Even a lantern that wanders comes home in time for the show.",
        "vi": "Alex trả khung đèn lồng cho đêm nhạc rồi. Cảm ơn cháu nha. Đèn có đi chơi xa thì cũng biết về kịp giờ diễn.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "opera",
          "type": "GO_TO",
        },
        {
          "npcId": "alex",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Vy needs my lantern frames for the evening concert, and that reminds me of a story. Walk all the way to the opera, where Alex borrowed them as a backdrop, and ask for them back. The moral, as usual, is about something else.",
          "title": "Lanterns borrowed for a backdrop",
        },
        "vi": {
          "description": "Vy cần mấy khung đèn lồng của ông cho đêm nhạc, mà nhắc tới là ông nhớ một câu chuyện. Đi một mạch qua nhà hát, chỗ Alex mượn làm phông chụp hình, rồi xin lại giùm. Bài học, như mọi khi, lại nói về chuyện khác.",
          "title": "Khung đèn lồng cho tấm phông",
        },
      },
    },
    {
      "giverNpcId": "ba",
      "payoff": {
        "en": "The old photo is with Tâm now. Thank you, cháu. A picture finding its way home is a fine ending to one of my wandering stories.",
        "vi": "Tấm ảnh cũ về với Tâm rồi. Cảm ơn cháu nha. Hình tìm được đường về nhà, chuyện dài dòng của ông cũng có cái kết đẹp rồi.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "opera",
          "type": "GO_TO",
        },
        {
          "npcId": "alex",
          "type": "TALK_TO",
        },
        {
          "itemId": "photo",
          "npcId": "son",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "This old photo has a story, and the story drifts. Walk to the opera, let Alex look it over, then carry the photo to Son. The moral, as always, is about something else.",
          "title": "The photo that wandered",
        },
        "vi": {
          "description": "Tấm hình cũ này có một câu chuyện, mà chuyện thì cứ lan man. Ra nhà hát, nhờ Alex ngó qua, rồi mang tấm hình tới cho Sơn. Bài học, như mọi khi, lại nói về chuyện khác.",
          "title": "Tấm hình đi lạc",
        },
      },
      "twist": {
        "line": {
          "en": "Alex: the man in this old photo is Tam’s grandfather. Forget Son — this belongs with Tam.",
          "vi": "Alex: người đàn ông trong tấm hình cũ này là ông nội của Tâm đó. Khỏi đưa Sơn — tấm này phải về với Tâm.",
        },
        "step": {
          "itemId": "photo",
          "npcId": "tam",
          "type": "DELIVER",
        },
      },
    },
    {
      "giverNpcId": "bread-vendor",
      "payoff": {
        "en": "Tâm has his baguette! Thanks, bạn. Ninety crunch decibels have a witness now; I may need a bigger sign.",
        "vi": "Chú Tâm có bánh mì rồi! Cảm ơn bạn nha. Chín chục đề-xi-ben có nhân chứng luôn; chắc chú phải làm bảng hiệu lớn hơn quá.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "baguette",
          "npcId": "tam",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "This baguette just tested at ninety crunch decibels, bạn — a personal best. Carry it to chú Tâm at the market before the crust drops below eighty.",
          "title": "A ninety-decibel loaf",
        },
        "vi": {
          "description": "Ổ này vừa đo được chín chục đề-xi-ben độ giòn đó bạn — kỷ lục luôn. Mang qua cho chú Tâm ở chợ trước khi vỏ tụt xuống dưới tám chục.",
          "title": "Ổ bánh chín chục đề-xi-ben",
        },
      },
    },
    {
      "giverNpcId": "bread-vendor",
      "payoff": {
        "en": "Cô Hoa has the fresh herbs! Thanks, bạn. Her pho and my baguettes can both start the market day properly now.",
        "vi": "Cô Hoa có rau thơm rồi! Cảm ơn bạn nha. Phở của cô với bánh mì của chú đều sẵn sàng mở hàng cho ra trò rồi.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "herbs",
          "npcId": "hoa",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring these fresh herbs to cô Hoa at the market.",
          "title": "Herbs for the pho stall",
        },
        "vi": {
          "description": "Mang rau thơm tươi này qua cho cô Hoa ở chợ.",
          "title": "Rau thơm cho sạp phở",
        },
      },
    },
    {
      "giverNpcId": "coffee-friend",
      "payoff": {
        "en": "Linh got my hello! Thanks, friend. That is one more person to wave over when we have an empty café chair.",
        "vi": "Chị Linh nhận lời chào rồi! Cảm ơn bạn nha. Quán có ghế trống là lại có thêm người để rủ ngồi chung rồi.",
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Linh in the park for the coffee regular, then return.",
          "title": "Duc's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến chị Linh ở công viên rồi quay lại nhé.",
          "title": "Lời nhắn của Anh Đức",
        },
      },
    },
    {
      "giverNpcId": "coffee-reader",
      "payoff": {
        "en": "My hello reached Linh. Thank you for taking it beyond the café! A small message can open a whole new chapter.",
        "vi": "Lời chào tới chị Linh rồi. Cảm ơn bạn mang nó ra khỏi quán nha! Một lời nhắn nhỏ cũng mở được một chương mới.",
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Linh in the park for the café reader, then return.",
          "title": "Quynh's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến chị Linh ở công viên rồi quay lại nhé.",
          "title": "Lời nhắn của Quỳnh",
        },
      },
    },
    {
      "giverNpcId": "commuter",
      "payoff": {
        "en": "You caught Linh with my hello! Thanks. I can make my next connection knowing that little visit is taken care of.",
        "vi": "Bạn gửi lời chào tới chị Linh rồi! Cảm ơn nha. Mình yên tâm bắt chuyến tiếp theo, khỏi nợ một lời hỏi thăm nữa.",
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Linh in the park for the commuter, then return.",
          "title": "Tuan's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến chị Linh ở công viên rồi quay lại nhé.",
          "title": "Lời nhắn của Tuấn",
        },
      },
    },
    {
      "giverNpcId": "fruit-vendor",
      "payoff": {
        "en": "You passed my hello to Linh! Thank you, con. Good neighbors are the sweetest part of market day.",
        "vi": "Con gửi lời chào của cô tới chị Linh rồi! Cảm ơn con nha. Hàng xóm thương nhau mới là phần ngọt nhất buổi chợ.",
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Linh in the park for the fruit vendor, then return.",
          "title": "Ms. Hanh's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến chị Linh ở công viên rồi quay lại nhé.",
          "title": "Lời nhắn của Cô Hạnh",
        },
      },
    },
    {
      "giverNpcId": "hoa",
      "payoff": {
        "en": "The lantern crew has their broth! Thank you, con. A three-bowl problem, solved in one kind delivery.",
        "vi": "Nhóm lồng đèn có nước lèo rồi! Cảm ơn con nha. Chuyện cỡ ba tô, một chuyến giao dễ thương là xong.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "alley",
          "type": "GO_TO",
        },
        {
          "npcId": "mai",
          "type": "TALK_TO",
        },
        {
          "itemId": "broth",
          "npcId": "linh",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "A three-bowl problem, con: duck into the alley, ask Mai where lunch landed, then rush this broth to Linh in the park while it is still a three-bowl broth.",
          "title": "A three-bowl delivery, con",
        },
        "vi": {
          "description": "Chuyện cỡ ba tô đó con: ghé vô hẻm, hỏi Mai bữa trưa dời đi đâu, rồi mang tô nước lèo này ra công viên cho chị Linh khi còn nóng cỡ ba tô.",
          "title": "Chuyện giao cỡ ba tô, con",
        },
      },
      "twist": {
        "line": {
          "en": "Mai: Linh’s lunch moved to Vy’s lantern crew — they are starving over there. Take the broth to Vy instead.",
          "vi": "Mai: bữa trưa của chị Linh dời qua nhóm làm lồng đèn của Vy rồi — tụi nó đói lả bên đó. Mang nước lèo qua cho Vy đi.",
        },
        "step": {
          "itemId": "broth",
          "npcId": "vy",
          "type": "DELIVER",
        },
      },
    },
    {
      "demo": true,
      "giverNpcId": "hoa",
      "payoff": {
        "en": "Linh has her broth. Thank you, con! I called it a two-bowl problem; one kind neighbor did the trick.",
        "vi": "Chị Linh nhận nước lèo rồi. Cảm ơn con nha! Cô tưởng chuyện cỡ hai tô, ai dè có con giúp là xong.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "broth",
          "npcId": "linh",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Chị Linh sounds like a two-bowl problem, con. Carry this broth to her in the park before it cools to a one-bowl mood.",
          "title": "A two-bowl problem",
        },
        "vi": {
          "description": "Chị Linh nghe như chuyện cỡ hai tô đó con. Mang tô nước lèo này ra công viên cho chị ấy trước khi nguội còn cỡ một tô.",
          "title": "Chuyện cỡ hai tô",
        },
      },
    },
    {
      "giverNpcId": "hoa",
      "payoff": {
        "en": "The herbs reached Linh for lunch. Thank you, con! That little bundle carries a whole bowl of care.",
        "vi": "Rau thơm tới chỗ chị Linh cho bữa trưa rồi. Cảm ơn con nha! Bó nhỏ vậy mà gói cả tô tình cảm đó.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "herbs",
          "npcId": "linh",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring these fresh herbs to Linh in the park.",
          "title": "Fresh herbs for a neighbor",
        },
        "vi": {
          "description": "Mang rau thơm này đến cho chị Linh ở công viên.",
          "title": "Rau thơm cho hàng xóm",
        },
      },
    },
    {
      "giverNpcId": "linh",
      "payoff": {
        "en": "You brought the lunch invitation to Cô Hoa! Thank you. One more neighbor at the table makes the whole lunch feel warmer.",
        "vi": "Bạn mang lời mời ăn trưa tới cô Hoa rồi! Cảm ơn nha. Thêm một người cùng bàn là bữa trưa ấm hơn hẳn.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "market",
          "type": "GO_TO",
        },
        {
          "npcId": "hoa",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Visit the market and invite Ms. Hoa to our neighborhood lunch.",
          "title": "A community lunch invitation",
        },
        "vi": {
          "description": "Ghé chợ và mời cô Hoa đến bữa trưa chung của xóm.",
          "title": "Lời mời ăn trưa của xóm",
        },
      },
    },
    {
      "giverNpcId": "linh",
      "payoff": {
        "en": "The herbs reached Cô Hoa! Thank you for the flawless logistics. Senior Deputy Herb Logistics Officer has a nice ring, does it not?",
        "vi": "Rau thơm tới cô Hoa rồi! Cảm ơn bạn lo hậu cần chu đáo nha. Phó phòng Cấp cao Hậu cần Rau thơm nghe cũng oai ha?",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "herbs",
          "npcId": "hoa",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "I am appointing you Deputy Herb Logistics Officer. Your first duty: deliver these herbs to Cô Hoa at the market. Badge pending.",
          "title": "Deputy Herb Logistics Officer",
        },
        "vi": {
          "description": "Chị bổ nhiệm bạn làm Phó phòng Hậu cần Rau thơm. Nhiệm vụ đầu tiên: mang rau thơm này cho Cô Hoa ở chợ. Huy hiệu sẽ có sau.",
          "title": "Phó phòng Hậu cần Rau thơm",
        },
      },
    },
    {
      "giverNpcId": "linh",
      "payoff": {
        "en": "Thảo has the invitation! Thank you. You are officially Head of Invitations; this neighborhood lunch has its entertainment now.",
        "vi": "Thảo nhận thư mời rồi! Cảm ơn bạn nha. Chính thức thăng làm Trưởng ban Thư mời luôn; bữa trưa xóm mình có văn nghệ rồi.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "market",
          "type": "GO_TO",
        },
        {
          "npcId": "hoa",
          "type": "TALK_TO",
        },
        {
          "itemId": "postcard",
          "npcId": "mai",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "I am appointing you Deputy Invitations Officer. Report to the market, recruit Cô Hoa to the committee, then deliver this invitation postcard to Mai for the neighborhood lunch.",
          "title": "Deputy Invitations Officer",
        },
        "vi": {
          "description": "Chị phong em làm Phó ban Thư mời. Ra chợ, mời Cô Hoa vào ban tổ chức, rồi mang tấm bưu thiếp mời này giao cho Mai cho bữa trưa của xóm nghen.",
          "title": "Phó ban Thư mời",
        },
      },
      "twist": {
        "line": {
          "en": "Hoa: Mai is not on the guest list — she is the guest list. Give the invite to Thao; she runs entertainment.",
          "vi": "Hoa: Mai đâu nằm trong danh sách khách — Mai chính là danh sách khách đó. Đưa thư mời cho Thảo đi, Thảo lo văn nghệ.",
        },
        "step": {
          "itemId": "postcard",
          "npcId": "thao",
          "type": "DELIVER",
        },
      },
    },
    {
      "gift": "coffee-beans",
      "giverNpcId": "mai",
      "milestone": "evening-concert",
      "payoff": {
        "en": "The beans are ready for Vy and the evening concert. Thank you! Tasting notes: dusk, good company, and an encore worth staying for.",
        "vi": "Cà phê hạt sẵn cho Vy với đêm nhạc rồi. Cảm ơn bạn nha! Hương vị: chạng vạng, bạn hiền, và một màn diễn thêm đáng nán lại.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "alley",
          "type": "GO_TO",
        },
        {
          "npcId": "hoa",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Vy wants real beans for the evening concert. Walk to the alley roaster, breathe in the smoke, then let Cô Hoa taste and vouch for them. Tasting notes: dusk, a little stage fright, a very big encore.",
          "title": "Beans worthy of a concert",
        },
        "vi": {
          "description": "Vy muốn có cà phê thiệt cho đêm nhạc. Ghé lò rang trong hẻm, hít chút khói thơm, rồi để Cô Hoa nếm thử và gật đầu giùm. Hương vị: chạng vạng, chút run trước giờ diễn, và một khúc kết thiệt dài.",
          "title": "Cà phê xứng tầm đêm nhạc",
        },
      },
    },
    {
      "giverNpcId": "mai",
      "payoff": {
        "en": "Cô Hoa has her coffee. Thank you! Tasting notes: a little sweetness, a busy market, and a very kind delivery.",
        "vi": "Cô Hoa nhận cà phê rồi. Cảm ơn bạn nha! Hương vị: một chút ngọt, một buổi chợ đông, một người giao dễ thương.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "coffee",
          "npcId": "hoa",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Take this coffee across the market to Ms. Hoa.",
          "title": "Coffee for Ms. Hoa",
        },
        "vi": {
          "description": "Mang ly cà phê này qua chợ cho cô Hoa.",
          "title": "Cà phê cho cô Hoa",
        },
      },
    },
    {
      "giverNpcId": "mai",
      "payoff": {
        "en": "Sơn has the coffee. Thank you! Tasting notes: a good detour and a reviewer who may write a whole postcard about it.",
        "vi": "Sơn nhận cà phê rồi. Cảm ơn bạn nha! Hương vị: một chuyến đổi đường hay ho, gặp người có khi viết cả bưu thiếp để bình ly này.",
      },
      "scope": "solo",
      "steps": [
        {
          "marketItemId": "banana",
          "type": "BUY",
        },
        {
          "npcId": "hoa",
          "type": "TALK_TO",
        },
        {
          "itemId": "coffee",
          "npcId": "hoa",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "First, a banana from the market as a palate cleanser. Then check in with Cô Hoa and hand her this cà phê sữa đá. Tasting notes: caramel, morning market, and a brave little bitterness.",
          "title": "Tasting notes: a palate cleanser",
        },
        "vi": {
          "description": "Trước hết, mua một trái chuối ngoài chợ để súc miệng cái đã. Rồi ghé Cô Hoa và đưa cô ly cà phê sữa đá này. Hương vị: caramel, chợ sớm, và một chút đắng gan lì.",
          "title": "Hương vị: món súc miệng",
        },
      },
      "twist": {
        "line": {
          "en": "Hoa: con, I am a pho person, not a coffee person. Give it to Son — he reviews everything.",
          "vi": "Hoa: con ơi, cô là người của phở chớ đâu phải cà phê. Đưa cho Sơn đi — cái gì nó cũng chấm điểm hết.",
        },
        "step": {
          "itemId": "coffee",
          "npcId": "son",
          "type": "DELIVER",
        },
      },
    },
    {
      "giverNpcId": "mai",
      "payoff": {
        "en": "Cô Hoa has her cà phê sữa đá. Thank you! The ambition made it across the market; the honest review is up to her.",
        "vi": "Cô Hoa có cà phê sữa đá rồi. Cảm ơn bạn nha! Chút hoài bão đã qua tới bên kia chợ; còn nhận xét thành thật thì để cô.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "coffee",
          "npcId": "hoa",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Carry this cà phê sữa đá to Cô Hoa. Tasting notes: caramel, a hint of afternoon rain, and quiet ambition. Do not shake the ambition out.",
          "title": "Tasting notes: caramel, rain, ambition",
        },
        "vi": {
          "description": "Mang ly cà phê sữa đá này tới Cô Hoa. Hương vị: caramel, chút mưa chiều, và một ít hoài bão lặng lẽ. Đừng lắc rớt hoài bão nha.",
          "title": "Hương vị: caramel, mưa, hoài bão",
        },
      },
    },
    {
      "giverNpcId": "market-browse",
      "payoff": {
        "en": "Linh has my hello. Thanks for making the trip! This market feels smaller, in a good way, when the neighbors know one another.",
        "vi": "Linh nhận lời chào rồi. Cảm ơn bạn đi giùm nha! Hàng xóm quen nhau, cái chợ tự nhiên gần gũi hơn hẳn.",
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Linh in the park for the market regular, then return.",
          "title": "Ngoc's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến chị Linh ở công viên rồi quay lại nhé.",
          "title": "Lời nhắn của Ngọc",
        },
      },
    },
    {
      "giverNpcId": "market-family",
      "payoff": {
        "en": "You said hello to Linh for me! Thank you. Between the bags and the shopping list, I would never have made that visit today.",
        "vi": "Bạn chào chị Linh giùm chị rồi! Cảm ơn nha. Nào túi nào giỏ nào danh sách, hôm nay không có bạn là chị chẳng ghé được.",
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Linh in the park for the family shopper, then return.",
          "title": "Huong's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến chị Linh ở công viên rồi quay lại nhé.",
          "title": "Lời nhắn của Chị Hương",
        },
      },
    },
    {
      "giverNpcId": "market-walk",
      "payoff": {
        "en": "My hello reached Linh! Thanks for covering that little route. Next time I pass the park, I will know a friend is there.",
        "vi": "Lời chào tới chị Linh rồi! Cảm ơn bạn chạy giùm đoạn đó nha. Lần sau ngang công viên là mình biết có người quen để chào rồi.",
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Linh in the park for the market courier, then return.",
          "title": "Dat's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến chị Linh ở công viên rồi quay lại nhé.",
          "title": "Lời nhắn của Đạt",
        },
      },
    },
    {
      "giverNpcId": "opera-visitor",
      "payoff": {
        "en": "Thảo has the photo. Thank you, bạn! Four stars for the delivery; the pigeons are lobbying for a fifth.",
        "vi": "Thảo nhận ảnh rồi. Cảm ơn bạn nha! Bốn sao cho chuyến giao; mấy con bồ câu đang vận động thêm sao thứ năm.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "photo",
          "npcId": "thao",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "I am filing tonight’s review, bạn. Carry this photo to chị Thảo at the Opera House and make your entrance count — I am scoring it, and the pigeons are an expert panel.",
          "title": "A four-star entrance",
        },
        "vi": {
          "description": "Mình đang viết bài bình tối nay, bạn. Mang tấm ảnh này cho chị Thảo ở Nhà hát và xuất hiện cho ra dáng — mình chấm điểm đó, mà ban giám khảo bồ câu khó tính lắm.",
          "title": "Màn xuất hiện bốn sao",
        },
      },
    },
    {
      "giverNpcId": "opera-visitor",
      "payoff": {
        "en": "Alex has the postcard! Thank you, bạn. A considerate delivery and no scene stolen from the neighbors: a very good review.",
        "vi": "Anh Alex nhận bưu thiếp rồi! Cảm ơn bạn nha. Giao thiệp chu đáo, lại không giành sân khấu của hàng xóm: đáng nhận xét tốt.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "postcard",
          "npcId": "alex",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring this postcard to anh Alex at the Opera House.",
          "title": "A note for a fellow regular",
        },
        "vi": {
          "description": "Mang tấm bưu thiếp này đến cho anh Alex ở Nhà hát.",
          "title": "Lời nhắn cho người quen",
        },
      },
    },
    {
      "giverNpcId": "opera-visitor",
      "payoff": {
        "en": "You found the neighbor in my review. Thank you, bạn! A thoughtful entrance, with or without a program note: four stars.",
        "vi": "Bạn tìm được người trong bài nhận xét rồi. Cảm ơn bạn nha! Có tờ chương trình hay không thì màn vào cửa cũng chu đáo: bốn sao.",
      },
      "riddle": {
        "text": {
          "en": "Find the neighbor who freezes a single moment and swears the pigeon planned the photobomb. Ask them for the review.",
          "vi": "Tìm người hàng xóm hay bắt lấy một khoảnh khắc rồi thề là con bồ câu cố tình phá ảnh. Hỏi họ lời nhận xét nhé.",
        },
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "alex",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "I turned tonight’s review into a riddle about a neighbor. Deduce who, or let a neighbor or a cyclo name them.",
          "title": "A riddle for opening night",
        },
        "vi": {
          "description": "Mình biến bài nhận xét tối nay thành câu đố về một người hàng xóm. Đoán xem là ai, hoặc để hàng xóm hay bác xích lô gọi tên.",
          "title": "Câu đố cho đêm khai diễn",
        },
      },
    },
    {
      "giverNpcId": "park-reader",
      "payoff": {
        "en": "You gave Cô Hoa my hello. Thank you, bạn. A nice little story has made it from this bench all the way to the market.",
        "vi": "Bạn chào cô Hoa giùm chú rồi. Cảm ơn nha. Một chuyện dễ thương từ ghế đá này đi tới tận chợ rồi đó.",
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "hoa",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Ms. Hoa at the market for the park reader, then return.",
          "title": "Mr. Phuc's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến cô Hoa ở chợ rồi quay lại nhé.",
          "title": "Lời nhắn của Chú Phúc",
        },
      },
    },
    {
      "giverNpcId": "park-stretch",
      "payoff": {
        "en": "Linh has the banana! Thanks for the delivery, bạn. That is one good-neighbor rep completed; give those shoulders a break.",
        "vi": "Chị Linh nhận chuối rồi! Cảm ơn bạn giao giùm nha. Xong một hiệp hàng xóm tốt rồi đó; cho vai nghỉ chút đi.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "banana",
          "npcId": "linh",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Perfect rep, bạn: take this banana to chị Linh in the park, but carry it at shoulder height the whole way — for the gains. Counts as a set.",
          "title": "A shoulder-height delivery",
        },
        "vi": {
          "description": "Một hiệp hoàn hảo nè bạn: mang trái chuối này cho chị Linh ở công viên, mà phải xách ngang vai suốt đường — cho lên cơ. Tính là một set.",
          "title": "Giao hàng ngang vai",
        },
      },
    },
    {
      "giverNpcId": "park-stretch",
      "payoff": {
        "en": "The herbs reached Linh for the park lunch! Thanks, bạn. That is a proper recovery meal and a good-neighbor rep in one.",
        "vi": "Rau thơm tới chị Linh cho bữa trưa công viên rồi! Cảm ơn bạn nha. Vừa lo bữa hồi sức, vừa xong một hiệp hàng xóm tốt luôn.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "herbs",
          "npcId": "linh",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring these herbs to chị Linh in the park.",
          "title": "Fresh herbs for the park lunch",
        },
        "vi": {
          "description": "Mang rau thơm này đến cho chị Linh ở công viên.",
          "title": "Rau thơm cho bữa trưa công viên",
        },
      },
    },
    {
      "giverNpcId": "plaza-friends",
      "payoff": {
        "en": "Linh has our hello! Thanks for taking a little of this square over to the park. Next time we can wave her over too.",
        "vi": "Chị Linh nhận lời chào rồi! Cảm ơn bạn mang chút không khí quảng trường qua công viên nha. Bữa nào gặp thì rủ chị ngồi chung luôn.",
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Linh in the park for the plaza neighbor, then return.",
          "title": "Ha's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến chị Linh ở công viên rồi quay lại nhé.",
          "title": "Lời nhắn của Hà",
        },
      },
    },
    {
      "giverNpcId": "plaza-stroll",
      "payoff": {
        "en": "Vy has the keepsake photo! Thank you, bạn. A little memory has found its next scene, and you delivered the line beautifully.",
        "vi": "Chị Vy nhận tấm hình kỷ niệm rồi! Cảm ơn bạn nha. Chút ký ức có cảnh diễn mới, còn bạn mang lời tới thật đẹp.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "photo",
          "npcId": "vy",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring this photo to chị Vy at City Hall.",
          "title": "A keepsake for a neighbor",
        },
        "vi": {
          "description": "Mang tấm ảnh này đến cho chị Vy ở Tòa Thị Chính.",
          "title": "Kỷ vật cho hàng xóm",
        },
      },
    },
    {
      "giverNpcId": "plaza-stroll",
      "payoff": {
        "en": "Alex has the verse! Thank you, bạn. A small postcard found its stage, and your kind delivery deserves an encore.",
        "vi": "Anh Alex nhận câu ngâm rồi! Cảm ơn bạn nha. Tấm thiệp nhỏ tìm được sân khấu, còn người mang lời tới đáng được vỗ tay thêm.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "postcard",
          "npcId": "alex",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "I have penned a single trembling verse on this postcard, bạn. Carry it to anh Alex at the Opera House and, when you hand it over, deliver the line out loud — gently, like the lamps are listening.",
          "title": "Deliver the line",
        },
        "vi": {
          "description": "Mình đã đề một câu ngâm run run lên tấm bưu thiếp này, bạn ơi. Mang qua cho anh Alex ở Nhà hát, và khi trao thì xuống câu thành tiếng — nhẹ thôi, như thể đèn đang lắng nghe.",
          "title": "Xuống câu giùm nhé",
        },
      },
    },
    {
      "giverNpcId": "postcard-reader",
      "payoff": {
        "en": "Sơn has the haiku. Thank you, bạn. The little boat has reached its shore; even the stamp can rest now.",
        "vi": "Sơn nhận bài haiku rồi. Cảm ơn bạn nha. Con thuyền nhỏ đã tới bến; cả con tem cũng được nghỉ rồi.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "postcard",
          "npcId": "son",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "I inked a haiku beside the stamp, bạn: blue stamp, patient glue / a small boat waits for the tide / carry it to shore. Take the postcard to anh Sơn at the post office.",
          "title": "A haiku for the stamp",
        },
        "vi": {
          "description": "Mình đề một bài haiku cạnh con tem, bạn ơi: tem xanh, keo kiên nhẫn / con thuyền nhỏ đợi con nước lên / mang tới bến giùm. Đưa tấm bưu thiếp cho anh Sơn ở bưu điện nhé.",
          "title": "Bài haiku cho con tem",
        },
      },
    },
    {
      "giverNpcId": "postcard-reader",
      "payoff": {
        "en": "Vy has the photo at City Hall. Thank you, bạn. A little square of light has found a place to stay.",
        "vi": "Chị Vy nhận ảnh ở Tòa Thị Chính rồi. Cảm ơn bạn nha. Một ô ánh sáng nhỏ đã có chỗ ở lại.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "photo",
          "npcId": "vy",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring this photo to chị Vy at City Hall.",
          "title": "A photo for City Hall",
        },
        "vi": {
          "description": "Mang tấm ảnh này đến cho chị Vy ở Tòa Thị Chính.",
          "title": "Tấm ảnh cho Tòa Thị Chính",
        },
      },
    },
    {
      "giverNpcId": "postcard-reader",
      "payoff": {
        "en": "The postcard reached the right poet. Thank you, bạn. Stamp, address, and riddle: all three finally rhyme.",
        "vi": "Tấm bưu thiếp tới đúng nhà thơ rồi. Cảm ơn bạn nha. Con tem, địa chỉ, câu đố: cuối cùng cả ba cũng vần.",
      },
      "riddle": {
        "text": {
          "en": "Carry this card to the neighbor who mails letters to the river and never waits for a reply. He will know the stamp.",
          "vi": "Mang tấm thiệp này đến người hàng xóm hay gửi thư cho dòng sông mà chẳng bao giờ chờ hồi âm. Anh ấy sẽ biết con tem.",
        },
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "postcard",
          "npcId": "son",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "A haiku for a hidden address. Work out who receives this postcard, or let a neighbor or a cyclo tell you.",
          "title": "A stamp-poem riddle",
        },
        "vi": {
          "description": "Một bài haiku cho địa chỉ còn giấu. Đoán xem ai nhận tấm bưu thiếp này, hoặc để hàng xóm hay bác xích lô mách cho.",
          "title": "Câu đố thơ con tem",
        },
      },
    },
    {
      "giverNpcId": "river-jogger",
      "payoff": {
        "en": "Linh — has the herbs! Thanks — bạn. Park lunch — is one step closer. Good pace — good neighbor.",
        "vi": "Chị Linh — nhận rau rồi! Cảm ơn — bạn nha. Bữa trưa công viên — gần hơn một bước. Nhịp tốt — hàng xóm tốt.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "herbs",
          "npcId": "linh",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring these herbs to chị Linh in the park.",
          "title": "Herbs on the way to the park",
        },
        "vi": {
          "description": "Mang rau thơm này đến cho chị Linh ở công viên.",
          "title": "Rau thơm trên đường ra công viên",
        },
      },
    },
    {
      "giverNpcId": "river-jogger",
      "payoff": {
        "en": "Bác Ba — has the banana! Thanks — bạn. One errand — across the line. Take a breath — that counts too.",
        "vi": "Bác Ba — có chuối rồi! Cảm ơn — bạn nha. Một chuyến giao — về đích. Nghỉ lấy hơi — cũng tính mà.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "banana",
          "npcId": "ba",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Quick — bạn — take this — banana — to bác Ba — by the river. But keep pace, do not — slow down, or it — counts as a — rest day. Go, go.",
          "title": "Keep pace with the banana",
        },
        "vi": {
          "description": "Nhanh — bạn — mang — trái chuối — này cho — bác Ba — bên sông. Mà giữ nhịp, đừng — chậm lại, không thì — tính là — ngày nghỉ. Chạy, chạy.",
          "title": "Giữ nhịp với trái chuối",
        },
      },
    },
    {
      "giverNpcId": "riverside-friends",
      "payoff": {
        "en": "You carried my hello to Linh! Thank you. It is good to have a little friendship running between the river and the park.",
        "vi": "Bạn mang lời chào tới chị Linh rồi! Cảm ơn nha. Có chút tình bạn nối bờ sông với công viên, vui ghê.",
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Linh in the park for the river neighbor, then return.",
          "title": "Nhi's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến chị Linh ở công viên rồi quay lại nhé.",
          "title": "Lời nhắn của Nhi",
        },
      },
    },
    {
      "giverNpcId": "son",
      "payoff": {
        "en": "You found the place in my riddle. Thank you, dear reader! For once, the postcard has written back.",
        "vi": "Bạn tìm được nơi trong câu đố rồi. Cảm ơn bạn đọc thân mến nha! Lần này tấm bưu thiếp có hồi âm thật rồi.",
      },
      "riddle": {
        "text": {
          "en": "A vaulted hall where old clocks pretend to be windows and the whole city mails its small stories. Begin where the letters wait.",
          "vi": "Gian sảnh mái vòm, mấy cái đồng hồ cũ giả làm cửa sổ, cả thành phố gửi những mẩu chuyện nhỏ ở đó. Bắt đầu nơi thư đang chờ.",
        },
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "postoffice",
          "type": "GO_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Dear Reader: I hid my favorite hall in a riddle. Guess where it stands, or let a neighbor or a cyclo read it aloud.",
          "title": "A riddle for the letters",
        },
        "vi": {
          "description": "Gửi bạn đọc: mình giấu gian sảnh mình thích trong một câu đố. Đoán xem nó ở đâu, hoặc để hàng xóm hay bác xích lô đọc giúp.",
          "title": "Câu đố cho những lá thư",
        },
      },
    },
    {
      "giverNpcId": "son",
      "payoff": {
        "en": "Thảo has the postcard for the river. Thank you for finding it a voice. Dear River: a song is on its way. Warmly, Sơn.",
        "vi": "Thảo nhận bưu thiếp gửi dòng sông rồi. Cảm ơn bạn đã tìm cho nó một giọng hát. Sông ơi, bài hát đang tới đó. Thương, Sơn.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "river",
          "type": "GO_TO",
        },
        {
          "npcId": "ba",
          "type": "TALK_TO",
        },
        {
          "itemId": "postcard",
          "npcId": "mai",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "I wrote a postcard. It opens, "Dear River, you looked tired today." Walk to the river, ask Ong Ba to hear it out, then carry the postcard to Mai.",
          "title": "Dear River, you looked tired",
        },
        "vi": {
          "description": "Mình viết một tấm bưu thiếp. Mở đầu là: "Sông ơi, bữa nay trông mệt quá." Ra bờ sông, nhờ Ông Ba nghe thử, rồi mang tấm thiếp tới cho Mai.",
          "title": "Sông ơi, bữa nay trông mệt",
        },
      },
      "twist": {
        "line": {
          "en": "Ba: the river cannot read, you know. But Thao sings to it every evening — give the postcard to her.",
          "vi": "Ba: sông đâu biết đọc đâu con. Nhưng chiều nào Thảo cũng hát cho nó nghe — đưa tấm thiếp cho Thảo đi.",
        },
        "step": {
          "itemId": "postcard",
          "npcId": "thao",
          "type": "DELIVER",
        },
      },
    },
    {
      "giverNpcId": "son",
      "payoff": {
        "en": "Ông Ba has my postcard for the river. Thank you for carrying that little wish. The river need not write back; knowing it arrived is enough.",
        "vi": "Ông Ba nhận bưu thiếp gửi dòng sông rồi. Cảm ơn bạn mang giùm lời nhắn nhỏ đó. Sông không cần hồi âm đâu; tới nơi là mình vui rồi.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "postcard",
          "npcId": "ba",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Deliver this postcard to Ông Ba by the river. It is addressed to the river itself: "Dear River, you looked tired today. Rest up. Warmly, Sơn."",
          "title": "Dear River, you looked tired today",
        },
        "vi": {
          "description": "Mang tấm bưu thiếp này cho Ông Ba ở bờ sông. Nó gửi cho chính dòng sông: "Gửi Dòng Sông, hôm nay trông mệt quá. Nghỉ ngơi nhé. Thân, Sơn."",
          "title": "Gửi Dòng Sông, hôm nay trông mệt quá",
        },
      },
    },
    {
      "giverNpcId": "son",
      "payoff": {
        "en": "You brought back a little river air. Thank you for the walk! Dear River: there is room for you on my next postcard.",
        "vi": "Bạn mang về chút gió sông rồi. Cảm ơn đã đi một vòng nha! Sông ơi, tấm bưu thiếp kế tiếp có chỗ cho sông rồi đó.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "river",
          "type": "GO_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Visit the riverside to bring back a little inspiration.",
          "title": "Room for a river view",
        },
        "vi": {
          "description": "Ghé bờ sông để mang về chút cảm hứng.",
          "title": "Chỗ cho cảnh sông",
        },
      },
    },
    {
      "giverNpcId": "square-tourist",
      "payoff": {
        "en": "Sơn has the photo at the post office! Thanks, bạn. That is one address my old map and I can finally agree on.",
        "vi": "Anh Sơn nhận ảnh ở bưu điện rồi! Cảm ơn bạn nha. Cuối cùng tôi với tấm bản đồ cũ cũng đồng ý được một địa chỉ.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "photo",
          "npcId": "son",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring this photo to anh Sơn at the Central Post Office.",
          "title": "A photo for the post office",
        },
        "vi": {
          "description": "Mang tấm ảnh này đến cho anh Sơn ở Bưu điện Trung tâm.",
          "title": "Tấm ảnh cho bưu điện",
        },
      },
    },
    {
      "giverNpcId": "square-tourist",
      "payoff": {
        "en": "You found our neighbor! Thanks, bạn. Map, hint, or happy accident, that is one landmark I can finally trust.",
        "vi": "Bạn tìm được người hàng xóm rồi! Cảm ơn bạn nha. Nhờ bản đồ, gợi ý hay tình cờ thì tôi cũng có một cột mốc đáng tin rồi.",
      },
      "riddle": {
        "text": {
          "en": "Find the neighbor who gives every paper lantern a dramatic name before dusk. My 1998 map is no help; ask them to point.",
          "vi": "Tìm người hàng xóm đặt cho mỗi chiếc lồng đèn giấy một cái tên thật kịch tính trước khi trời tối. Tấm bản đồ 1998 của tôi chịu; nhờ họ chỉ đường.",
        },
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "vy",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "I am proudly lost, so I made a riddle about a neighbor instead. Guess who, or let a neighbor or a cyclo say the name.",
          "title": "A riddle, map optional",
        },
        "vi": {
          "description": "Tôi lạc đường một cách tự hào, nên đố bạn về một người hàng xóm. Đoán xem là ai, hoặc để hàng xóm hay bác xích lô nói tên.",
          "title": "Câu đố, khỏi cần bản đồ",
        },
      },
    },
    {
      "giverNpcId": "square-tourist",
      "payoff": {
        "en": "Vy has the postcard at City Hall! Thank you, bạn. My 1998 map calls that a successful river trip; I call it excellent company.",
        "vi": "Chị Vy nhận thiệp ở Tòa Thị Chính rồi! Cảm ơn bạn nha. Bản đồ 1998 gọi đó là chuyến ra sông thành công; tôi gọi là gặp được bạn đồng hành tốt.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "postcard",
          "npcId": "vy",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "My 1998 map swears the river is this way, bạn, which means it is actually City Hall. Take this postcard to chị Vy there — if you reach water, we are both lost.",
          "title": "Where the map says the river is",
        },
        "vi": {
          "description": "Bản đồ 1998 của mình thề đây là hướng bờ sông, bạn ơi, nghĩa là thật ra là Tòa Thị Chính. Mang tấm bưu thiếp này cho chị Vy ở đó — nếu bạn ra tới mé nước thì cả hai cùng lạc.",
          "title": "Chỗ bản đồ ghi là bờ sông",
        },
      },
    },
    {
      "giverNpcId": "student",
      "payoff": {
        "en": "Cô Hoa got my hello! Thank you. You have made my next market visit feel a little more like coming home.",
        "vi": "Cô Hoa nhận lời chào rồi! Cảm ơn bạn nha. Lần tới ghé chợ, mình thấy giống về nhà hơn một chút rồi.",
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "hoa",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Ms. Hoa at the market for the student, then return.",
          "title": "Minh's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến cô Hoa ở chợ rồi quay lại nhé.",
          "title": "Lời nhắn của Minh",
        },
      },
    },
    {
      "giverNpcId": "tam",
      "payoff": {
        "en": "Thanks for checking on Ông Ba by the river! A hello from a neighbor is a good reason to slow down, even for me.",
        "vi": "Cảm ơn em ghé hỏi thăm ông Ba bên sông nha! Một tiếng chào hàng xóm cũng đáng chạy chậm lại, kể cả với anh.",
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "ba",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Check on Mr. Ba by the river and say hello.",
          "title": "A riverside hello",
        },
        "vi": {
          "description": "Ghé thăm ông Ba bên sông và chào ông một tiếng.",
          "title": "Lời chào bên sông",
        },
      },
    },
    {
      "giverNpcId": "tam",
      "payoff": {
        "en": "Cô Hoa has her coffee! Thanks, em. Two songs or three, you made this shortcut worth bragging about.",
        "vi": "Cô Hoa có cà phê rồi! Cảm ơn em nha. Hai bài hay ba bài cũng được, chuyến đường tắt này đáng để anh khoe rồi.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "coffee",
          "npcId": "hoa",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Run this cà phê to Cô Hoa by my shortcut. It is exactly two songs long. Three if you hum slowly, which you will.",
          "title": "The two-song shortcut",
        },
        "vi": {
          "description": "Mang ly cà phê này tới Cô Hoa theo đường tắt của anh. Đúng hai bài hát thôi. Ba bài nếu em ngân nga chậm, mà chắc em sẽ vậy.",
          "title": "Đường tắt hai bài hát",
        },
      },
    },
    {
      "giverNpcId": "tam",
      "payoff": {
        "en": "The cake reached Ông Ba for the riverside wedding! Thanks for carrying those three tiers of trust. I am telling everyone you were the express route.",
        "vi": "Bánh tới chỗ ông Ba cho đám cưới bên sông rồi! Cảm ơn em đã mang ba tầng tin tưởng nha. Để anh khoe em mới là đường tắt xịn nhất.",
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "mai",
          "type": "TALK_TO",
        },
        {
          "itemId": "cake",
          "npcId": "mai",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "My helmet is at the polisher, so I cannot drive this wedding cake myself. Check in with Mai, then carry the cake to her — gently, it is three tiers of trust.",
          "title": "Wedding cake express",
        },
        "vi": {
          "description": "Nón bảo hiểm của anh đang ở tiệm đánh bóng, nên anh không tự chở bánh cưới này được. Ghé Mai một tiếng, rồi mang bánh tới cho chị ấy — nhẹ tay nghen, ba tầng niềm tin đó.",
          "title": "Chuyển phát bánh cưới",
        },
      },
      "twist": {
        "line": {
          "en": "Mai: the wedding moved to the riverside! Ông Ba is the chủ hôn now. Take the cake to him.",
          "vi": "Mai: đám cưới dời ra bờ sông rồi! Ông Ba làm chủ hôn giờ. Mang bánh ra cho ông đi.",
        },
        "step": {
          "itemId": "cake",
          "npcId": "ba",
          "type": "DELIVER",
        },
      },
    },
    {
      "giverNpcId": "thao",
      "payoff": {
        "en": "Sơn has his coffee. Thank you for carrying the rhythm across the city! I think the chorus will be named after your shoes.",
        "vi": "Sơn có cà phê rồi. Cảm ơn bạn mang cả nhịp chân qua phố nha! Chắc mình đặt tên điệp khúc theo đôi giày của bạn quá.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "coffee",
          "npcId": "son",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring this coffee to Sơn at the post office. I am composing a tiny ballad about your footsteps; try to walk in a nice rhythm so the chorus works.",
          "title": "A little ballad for the errand",
        },
        "vi": {
          "description": "Mang ly cà phê này cho Sơn ở bưu điện. Mình đang soạn một khúc ballad nhỏ về bước chân bạn; đi nhịp nhàng chút để điệp khúc nghe cho hay nhé.",
          "title": "Khúc ballad nhỏ cho chuyến đi",
        },
      },
    },
    {
      "giverNpcId": "thao",
      "payoff": {
        "en": "You found the echo! Thank you for listening so closely. However you found your way, my little ballad has a first verse now.",
        "vi": "Bạn tìm được tiếng vọng rồi! Cảm ơn đã chịu lắng nghe nha. Dù tìm đường cách nào, khúc ballad nhỏ của mình cũng có câu mở đầu rồi.",
      },
      "riddle": {
        "text": {
          "en": "Two red-brick bell towers keep the square’s best echo. The pigeons only pretend to conduct. Stand where it answers.",
          "vi": "Hai tháp chuông gạch đỏ giữ tiếng vọng đẹp nhất quảng trường. Bồ câu chỉ giả bộ bắt nhịp thôi. Đến nơi tiếng vọng trả lời nhé.",
        },
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "cathedral",
          "type": "GO_TO",
        },
      ],
      "text": {
        "en": {
          "description": "I caught a melody in the square and set it as a riddle. Solve where it lives, or let a neighbor or a cyclo tell you.",
          "title": "A riddle for the echo",
        },
        "vi": {
          "description": "Mình bắt được một giai điệu ngoài quảng trường và đố bạn. Đoán xem nó ở đâu, hoặc để hàng xóm hay bác xích lô mách cho.",
          "title": "Câu đố cho tiếng vọng",
        },
      },
    },
    {
      "giverNpcId": "thao",
      "payoff": {
        "en": "You listened at the cathedral square. Thank you for sharing that quiet moment! The city sounds a little less lonely with someone else listening.",
        "vi": "Bạn lắng nghe ở quảng trường nhà thờ rồi. Cảm ơn đã chia sẻ chút yên đó nha! Có người cùng nghe, tiếng phố cũng bớt cô đơn.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "cathedral",
          "type": "GO_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Listen to the city at the cathedral square.",
          "title": "An echo across the square",
        },
        "vi": {
          "description": "Lắng nghe thành phố ở quảng trường nhà thờ.",
          "title": "Tiếng vọng qua quảng trường",
        },
      },
    },
    {
      "giverNpcId": "thao",
      "payoff": {
        "en": "So the melody came from Linh and her megaphone! Thank you for following that echo. My city song has its very surprising chorus now.",
        "vi": "Thì ra giai điệu từ chị Linh với cái loa phóng thanh! Cảm ơn bạn lần theo tiếng vọng nha. Bài hát thành phố có điệp khúc bất ngờ quá chừng.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "cathedral",
          "type": "GO_TO",
        },
        {
          "npcId": "son",
          "type": "TALK_TO",
        },
        {
          "npcId": "vy",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "I hear a melody in the square and I must find its source. Go to the cathedral, ask Son what he heard, then find Vy — her lanterns might be humming.",
          "title": "The echo across the square",
        },
        "vi": {
          "description": "Mình nghe một giai điệu vang trong quảng trường và phải tìm cho ra nguồn. Ra nhà thờ, hỏi Sơn nghe được gì, rồi tìm Vy — biết đâu mấy chiếc lồng đèn của bạn ấy đang ngân nga.",
          "title": "Tiếng vọng qua quảng trường",
        },
      },
      "twist": {
        "line": {
          "en": "Son: that was no lantern. The echo was Linh practicing with her megaphone. Go ask her.",
          "vi": "Sơn: lồng đèn gì đâu. Tiếng vọng đó là Linh tập loa phóng thanh đó. Qua hỏi chị ấy đi.",
        },
        "step": {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      },
    },
    {
      "gift": "sheet-music",
      "giverNpcId": "thao",
      "milestone": "evening-concert",
      "payoff": {
        "en": "Sơn helped find the missing bars, and the score is whole for Vy’s concert. Thank you! I can finally hear the bridge leading everyone home.",
        "vi": "Sơn giúp tìm được mấy ô nhịp thất lạc, bản nhạc đủ cho đêm diễn của Vy rồi. Cảm ơn bạn nha! Mình nghe được đoạn chuyển dẫn mọi người về cùng nhau rồi.",
      },
      "riddle": {
        "text": {
          "en": "My melody lost its bridge where two red-brick towers trade an echo. Stand where the square answers, then find the postcard poet who kept my missing bars.",
          "vi": "Đoạn nhạc lạc nơi hai tháp gạch đỏ trao tiếng vọng. Đứng chỗ quảng trường đáp lại, rồi tìm người viết bưu thiếp đang giữ mấy nhịp thất lạc.",
        },
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "cathedral",
          "type": "GO_TO",
        },
        {
          "npcId": "son",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Vy needs my sheet music for the evening concert, but the bridge is missing. Solve where the melody hides, then ask Son — he kept the bars I lost. A neighbor or a cyclo can whisper the answer.",
          "title": "The missing bars of the concert",
        },
        "vi": {
          "description": "Vy cần bản nhạc của mình cho đêm nhạc, mà đoạn cầu thì mất tiêu. Đoán xem giai điệu trốn ở đâu, rồi hỏi Sơn — nó giữ mấy nhịp mình làm rớt. Hàng xóm hay bác xích lô có thể mách nhỏ cho.",
          "title": "Mấy nhịp thất lạc của đêm nhạc",
        },
      },
    },
    {
      "giverNpcId": "vy",
      "payoff": {
        "en": "Alex has the announcement for Phở Moon. Thank you! Our little lantern has a name, a story, and someone ready to catch its glow.",
        "vi": "Alex nhận thiệp báo tin về Phở Moon rồi. Cảm ơn bạn nha! Chiếc đèn nhỏ có tên, có chuyện, lại có người chờ chụp ánh sáng của nó nữa.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "alley",
          "type": "GO_TO",
        },
        {
          "npcId": "hoa",
          "type": "TALK_TO",
        },
        {
          "itemId": "postcard",
          "npcId": "thao",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "A new lantern needs a name and a dramatic backstory. Hang it in the alley, ask Cô Hoa for the name, then send the announcement postcard to Thao.",
          "title": "A lantern needs a name",
        },
        "vi": {
          "description": "Chiếc lồng đèn mới cần một cái tên và một câu chuyện thật kịch tính. Treo nó trong hẻm, nhờ Cô Hoa đặt tên, rồi gửi tấm bưu thiếp thông báo cho Thảo.",
          "title": "Lồng đèn cần một cái tên",
        },
      },
      "twist": {
        "line": {
          "en": "Hoa: I named it "Pho Moon." Thao hates puns, so send the card to Alex — he will photograph it.",
          "vi": "Hoa: cô đặt tên nó là "Phở Moon." Thảo ghét chơi chữ lắm, nên gửi tấm thiệp cho Alex đi — nó sẽ chụp hình cho.",
        },
        "step": {
          "itemId": "postcard",
          "npcId": "alex",
          "type": "DELIVER",
        },
      },
    },
    {
      "giverNpcId": "vy",
      "payoff": {
        "en": "You found a welcoming corner in the food alley. Thank you for taking that little walk! Every warm doorway feels like another lantern.",
        "vi": "Bạn tìm được góc ấm trong hẻm ẩm thực rồi. Cảm ơn đã đi một vòng nha! Mỗi ô cửa đón người như thêm một ngọn đèn vậy.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "alley",
          "type": "GO_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Visit the food alley and look for a welcoming evening corner.",
          "title": "An evening walk",
        },
        "vi": {
          "description": "Ghé hẻm ẩm thực và tìm một góc phố buổi tối thật ấm cúng.",
          "title": "Dạo phố buổi tối",
        },
      },
    },
    {
      "giverNpcId": "vy",
      "payoff": {
        "en": "The coffee reached Mai for the lantern crew. Thank you! Phở Moon has its caffeine tribute; now we can keep the evening glowing.",
        "vi": "Cà phê tới chỗ Mai cho nhóm lồng đèn rồi. Cảm ơn bạn nha! Phở Moon có phần cà phê cổ vũ, tụi mình lại thắp sáng buổi tối tiếp.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "coffee",
          "npcId": "mai",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Take this cà phê to Mai for the lantern crew. Tell her it is for "Phở Moon", the lantern that survived last year's drizzle. A hero deserves caffeine.",
          "title": "Coffee for the lantern crew",
        },
        "vi": {
          "description": "Mang ly cà phê này cho Mai cho đội làm đèn lồng. Nói với chị ấy là dành cho "Trăng Phở", chiếc đèn sống sót qua cơn mưa phùn năm ngoái. Anh hùng thì xứng đáng có cà phê.",
          "title": "Cà phê cho đội đèn lồng",
        },
      },
    },
    {
      "giverNpcId": "vy",
      "milestone": "evening-concert",
      "payoff": {
        "en": "Lanterns up, coffee ready, the melody whole again. Thank you for bringing us together! The square has its concert; Encore Moon shines for you too.",
        "vi": "Đèn lên, cà phê sẵn, giai điệu lại nguyên vẹn. Cảm ơn bạn đã nối mọi người với nhau! Đêm nhạc này là của cả xóm, Trăng Encore cũng sáng vì bạn nữa.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "lanterns",
          "npcId": "vy",
          "type": "BRING",
        },
        {
          "itemId": "sheet-music",
          "npcId": "vy",
          "type": "BRING",
        },
        {
          "itemId": "coffee-beans",
          "npcId": "vy",
          "type": "BRING",
        },
      ],
      "text": {
        "en": {
          "description": "You have the lanterns, the sheet music, and the beans. Bring all three to me at City Hall and we will light the square. I have already named the first lantern "Encore Moon."",
          "title": "The evening concert at City Hall",
        },
        "vi": {
          "description": "Bạn đã có đèn lồng, bản nhạc và cà phê. Mang cả ba tới cho mình trước Ủy ban, rồi tụi mình thắp sáng cả quảng trường. Mình đặt tên chiếc đèn đầu tiên là "Trăng Encore" rồi đó.",
          "title": "Đêm nhạc trước Ủy ban",
        },
      },
    },
  ],
