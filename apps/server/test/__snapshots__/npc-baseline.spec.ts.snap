      {
        "description": "Mang rau thơm này đến cho chị Linh ở công viên.",
        "giverNpcId": "hoa",
        "payoff": "Rau thơm tới chỗ chị Linh cho bữa trưa rồi. Cảm ơn con nha! Bó nhỏ vậy mà gói cả tô tình cảm đó.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "herbs",
            "npcId": "linh",
