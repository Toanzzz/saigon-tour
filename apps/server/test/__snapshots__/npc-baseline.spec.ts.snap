        "giverNpcId": "park-stretch",
        "payoff": "Chị Linh nhận chuối mà vai bạn giữ nguyên tới nơi hả? Trọn một set đó bạn. Lên cơ chắc rồi.",
        "scope": "solo",
        "steps": [
