      {
        "description": "Mình đang săn khung hình chân thật. Ra quảng trường nhà thờ tìm ánh sáng, hỏi Sơn nên chụp gì, rồi mang tấm hình giao cho Vy trước khi có con bồ câu nhảy vô phá khung hình.",
        "giverNpcId": "alex",
        "payoff": "Ông Ba nhận tấm hình xích lô rồi! Cảm ơn bạn giúp nó về đúng chỗ nha. Phần đẹp nhất của khung hình hóa ra chờ ngay trong góc.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "cathedral",
            "type": "GO_TO",
          },
          {
            "npcId": "son",
            "type": "TALK_TO",
          },
          {
            "itemId": "photo",
            "npcId": "vy",
            "type": "DELIVER",
          },
        ],
        "title": "Khung hình chân thật",
        "twist": {
          "line": "Sơn: chủ thể đẹp nhất là chiếc xích lô ở góc hình kìa, mà nó là của ông Ba. Tấm hình này phải đưa ông mới đúng.",
          "step": {
            "itemId": "photo",
            "npcId": "ba",
            "type": "DELIVER",
          },
        },
      },
      {
        "description": "Mang tấm ảnh này cho Sơn ở bưu điện. Đây là tấm Nhà hát chân thật nhất của mình. Góc ảnh có con bồ câu đang chớp mắt. Nó làm nên tấm hình.",
        "giverNpcId": "alex",
        "payoff": "Sơn nhận tấm hình Nhà hát rồi. Cảm ơn bạn nha! Bồ câu có khán giả, còn mình có thêm lý do giữ mấy tấm chụp tình cờ.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "photo",
            "npcId": "son",
            "type": "DELIVER",
          },
        ],
        "title": "Tấm ảnh chân thật",
      },
      {
        "description": "Ghé quảng trường nhà thờ và tìm ánh nắng buổi chiều.",
        "giverNpcId": "alex",
        "payoff": "Bạn tìm được ánh sáng ngoài quảng trường nhà thờ rồi! Cảm ơn đã cùng mình ngắm nha. Thành phố lúc nào cũng cho thêm một góc nhìn.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "cathedral",
            "type": "GO_TO",
          },
        ],
        "title": "Ánh sáng qua quảng trường",
      },
      {
        "description": "Mình biến phông nền đẹp nhất phố thành câu đố. Đoán xem nó ở đâu, hoặc để hàng xóm hay bác xích lô bật mí.",
        "giverNpcId": "alex",
        "payoff": "Bạn tìm được phông nền rồi! Cảm ơn đã cùng mình lần theo ánh sáng nha. Nhờ gợi ý hay đoán trúng thì khung hình này cũng là của bạn.",
        "riddle": {
          "text": "Rèm nhung, bậc thang bề thế, mặt tiền lúc nào cũng tạo dáng cho ảnh. Tới trễ cũng bị chấm điểm. Tìm sân khấu đó đi.",
        },
        "scope": "solo",
        "steps": [
          {
            "locationId": "opera",
            "type": "GO_TO",
          },
        ],
        "title": "Câu đố đáng một khung hình",
      },
    ],
  },
  "alley-diner": {
