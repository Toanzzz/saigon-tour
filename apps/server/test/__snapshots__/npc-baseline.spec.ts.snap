  "opera-visitor": {
    "en": [
      {
        "description": "I am filing tonight’s review, bạn. Carry this photo to chị Thảo at the Opera House and make your entrance count — I am scoring it, and the pigeons are an expert panel.",
        "giverNpcId": "opera-visitor",
        "payoff": "Thảo took the photo and your entrance held? Four stars, bạn. The pigeons wanted five; they always overrate.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "photo",
            "npcId": "thao",
            "type": "DELIVER",
          },
        ],
        "title": "A four-star entrance",
      },
      {
        "description": "Bring this postcard to anh Alex at the Opera House.",
        "giverNpcId": "opera-visitor",
        "scope": "solo",
        "steps": [
          {
            "itemId": "postcard",
            "npcId": "alex",
            "type": "DELIVER",
          },
        ],
        "title": "A note for a fellow regular",
      },
      {
        "description": "I turned tonight’s review into a riddle about a neighbor. Deduce who, or let a neighbor or a cyclo name them.",
        "giverNpcId": "opera-visitor",
        "payoff": "You found my critic without a program note. Four stars for the entrance.",
        "riddle": {
          "text": "Find the neighbor who freezes a single moment and swears the pigeon planned the photobomb. Ask them for the review.",
        },
        "scope": "solo",
        "steps": [
          {
            "npcId": "alex",
            "type": "TALK_TO",
          },
        ],
        "title": "A riddle for opening night",
      },
    ],
    "vi": [
      {
        "description": "Mình đang viết bài bình tối nay, bạn. Mang tấm ảnh này cho chị Thảo ở Nhà hát và xuất hiện cho ra dáng — mình chấm điểm đó, mà ban giám khảo bồ câu khó tính lắm.",
        "giverNpcId": "opera-visitor",
        "payoff": "Chị Thảo nhận ảnh mà màn xuất hiện của bạn vững hả? Bốn sao đó bạn. Bồ câu đòi năm; tụi nó lúc nào cũng chấm lố.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "photo",
            "npcId": "thao",
            "type": "DELIVER",
          },
        ],
        "title": "Màn xuất hiện bốn sao",
      },
      {
        "description": "Mang tấm bưu thiếp này đến cho anh Alex ở Nhà hát.",
        "giverNpcId": "opera-visitor",
        "scope": "solo",
        "steps": [
          {
            "itemId": "postcard",
            "npcId": "alex",
            "type": "DELIVER",
          },
        ],
        "title": "Lời nhắn cho người quen",
      },
      {
        "description": "Mình biến bài nhận xét tối nay thành câu đố về một người hàng xóm. Đoán xem là ai, hoặc để hàng xóm hay bác xích lô gọi tên.",
        "giverNpcId": "opera-visitor",
        "payoff": "Bạn tìm ra nhà phê bình của mình mà chẳng cần tờ chương trình. Bốn sao cho màn vào cửa.",
        "riddle": {
          "text": "Tìm người hàng xóm hay bắt lấy một khoảnh khắc rồi thề là con bồ câu cố tình phá ảnh. Hỏi họ lời nhận xét nhé.",
        },
        "scope": "solo",
        "steps": [
          {
            "npcId": "alex",
            "type": "TALK_TO",
          },
        ],
        "title": "Câu đố cho đêm khai diễn",
      },
    ],
  },
