  "QUEST_SEEDS": [
    {
      "giverNpcId": "alex",
      "payoff": {
        "en": "You framed it without a hint. The pigeon still photobombed, but that is on the pigeon.",
        "vi": "Bạn canh được khung mà không cần gợi ý. Con bồ câu vẫn phá ảnh, mà đó là lỗi của nó.",
      },
      "riddle": {
        "text": {
          "en": "Velvet curtains, a grand staircase, and a façade that poses for every photo. Even latecomers get reviewed here. Find the stage.",
          "vi": "Rèm nhung, bậc thang bề thế, mặt tiền lúc nào cũng tạo dáng cho ảnh. Tới trễ cũng bị chấm điểm. Tìm sân khấu đó đi.",
        },
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "opera",
          "type": "GO_TO",
        },
      ],
      "text": {
        "en": {
          "description": "I set the best backdrop in town as a riddle. Work out where it stands, or let a neighbor or a cyclo give it away.",
          "title": "A riddle worth a frame",
        },
        "vi": {
          "description": "Mình biến phông nền đẹp nhất phố thành câu đố. Đoán xem nó ở đâu, hoặc để hàng xóm hay bác xích lô bật mí.",
          "title": "Câu đố đáng một khung hình",
        },
      },
    },
    {
      "giverNpcId": "alex",
      "scope": "solo",
      "steps": [
        {
          "locationId": "cathedral",
          "type": "GO_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Visit the cathedral square and find the afternoon light.",
          "title": "Light across the square",
        },
        "vi": {
          "description": "Ghé quảng trường nhà thờ và tìm ánh nắng buổi chiều.",
          "title": "Ánh sáng qua quảng trường",
        },
      },
    },
    {
      "giverNpcId": "alex",
      "payoff": {
        "en": "Ba loved the cyclo in the corner? Of course. The authentic shot is always the one you did not frame.",
        "vi": "Ông Ba mê chiếc xích lô ở góc hình hả? Dĩ nhiên rồi. Khung hình chân thật luôn là cái mình không cố chụp.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "cathedral",
          "type": "GO_TO",
        },
        {
          "npcId": "son",
          "type": "TALK_TO",
        },
        {
          "itemId": "photo",
          "npcId": "vy",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "I am chasing the authentic shot. Scout the cathedral square for the light, ask Son what to frame, then deliver the photo to Vy before a pigeon photobombs the whole plan.",
          "title": "The authentic shot",
        },
        "vi": {
          "description": "Mình đang săn khung hình chân thật. Ra quảng trường nhà thờ tìm ánh sáng, hỏi Sơn nên chụp gì, rồi mang tấm hình giao cho Vy trước khi có con bồ câu nhảy vô phá khung hình.",
          "title": "Khung hình chân thật",
        },
      },
      "twist": {
        "line": {
          "en": "Son: the best subject is the cyclo in the corner, and it is Ba’s. The photo belongs to him.",
          "vi": "Sơn: chủ thể đẹp nhất là chiếc xích lô ở góc hình kìa, mà nó là của ông Ba. Tấm hình này phải đưa ông mới đúng.",
        },
        "step": {
          "itemId": "photo",
          "npcId": "ba",
          "type": "DELIVER",
        },
      },
    },
    {
      "giverNpcId": "alex",
      "payoff": {
        "en": "Sơn liked the pigeon more than the Opera House. Honestly? So do I now.",
        "vi": "Sơn thích con bồ câu hơn cả Nhà hát. Thành thật mà nói? Giờ mình cũng vậy.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "photo",
          "npcId": "son",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring this photo to Sơn at the post office. It is my most authentic shot of the Opera House. There is a pigeon mid-blink in the corner. It completes it.",
          "title": "The authentic shot",
        },
        "vi": {
          "description": "Mang tấm ảnh này cho Sơn ở bưu điện. Đây là tấm Nhà hát chân thật nhất của mình. Góc ảnh có con bồ câu đang chớp mắt. Nó làm nên tấm hình.",
          "title": "Tấm ảnh chân thật",
        },
      },
    },
    {
      "giverNpcId": "alley-diner",
      "payoff": {
        "en": "Hoa got the broth without a spill, bạn? Score holds at nine-point-four. The chef and the judge agree.",
        "vi": "Cô Hoa nhận tô mà không đổ giọt nào hả bạn? Vậy giữ nguyên chín phẩy tư. Đầu bếp với giám khảo nhất trí.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "broth",
          "npcId": "hoa",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "I scored this broth a nine-point-four, bạn: rich opening, strong finish. Take it to cô Hoa at the market so the judge can meet the chef — carefully, a spill drops it to a nine-point-one.",
          "title": "A nine-point-four broth",
        },
        "vi": {
          "description": "Mình chấm tô nước lèo này chín phẩy tư nè bạn: mở vị đậm, hậu mạnh. Mang qua cho cô Hoa ở chợ để giám khảo gặp đầu bếp — nhẹ tay thôi, đổ một giọt là rớt còn chín phẩy một.",
          "title": "Tô nước lèo chín phẩy tư",
        },
      },
    },
    {
      "giverNpcId": "alley-diner",
      "scope": "solo",
      "steps": [
        {
          "itemId": "noodles",
          "npcId": "linh",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring these noodles to chị Linh in the park.",
          "title": "Noodles for the park lunch",
        },
        "vi": {
          "description": "Mang phần mì này đến cho chị Linh ở công viên.",
          "title": "Mì cho bữa trưa công viên",
        },
      },
    },
    {
      "giverNpcId": "alley-vendor",
      "scope": "solo",
      "steps": [
        {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Linh in the park for the alley cook, then return.",
          "title": "Mr. Loc's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến chị Linh ở công viên rồi quay lại nhé.",
          "title": "Lời nhắn của Chú Lộc",
        },
      },
    },
    {
      "giverNpcId": "ba",
      "payoff": {
        "en": "Sơn has it? Good. And that, you see, is why you should never trust a tram timetable. Long story.",
        "vi": "Sơn nhận rồi hả? Tốt. Và đó, cháu thấy chưa, là lý do đừng bao giờ tin giờ tàu điện. Chuyện dài lắm.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "photo",
          "npcId": "son",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Take this old photo to Sơn by the post office. It reminds me of a fish I once lost, which taught me patience. Or was it the fish that was patient?",
          "title": "A photo and a moral",
        },
        "vi": {
          "description": "Mang tấm hình cũ này cho Sơn ở bưu điện giúp ông. Nó làm ông nhớ con cá ông từng vuột mất, dạy ông tính kiên nhẫn. Hay con cá mới là đứa kiên nhẫn ta?",
          "title": "Tấm hình và một bài học",
        },
      },
    },
    {
      "giverNpcId": "ba",
      "scope": "solo",
      "steps": [
        {
          "locationId": "opera",
          "type": "GO_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Visit the Opera House and find another side of our city.",
          "title": "A view along the river",
        },
        "vi": {
          "description": "Ghé Nhà hát Thành phố và khám phá một góc khác của thành phố.",
          "title": "Ngắm cảnh dọc sông",
        },
      },
    },
    {
      "giverNpcId": "ba",
      "payoff": {
        "en": "Tam teared up? See, that is the moral: a photo always finds its way home, like my stories find the point.",
        "vi": "Tâm rưng rưng hả? Thấy chưa, đó là bài học: tấm hình nào rồi cũng tìm đường về nhà, như chuyện của ông rồi cũng tới chỗ cần tới.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "opera",
          "type": "GO_TO",
        },
        {
          "npcId": "alex",
          "type": "TALK_TO",
        },
        {
          "itemId": "photo",
          "npcId": "son",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "This old photo has a story, and the story drifts. Walk to the opera, let Alex look it over, then carry the photo to Son. The moral, as always, is about something else.",
          "title": "The photo that wandered",
        },
        "vi": {
          "description": "Tấm hình cũ này có một câu chuyện, mà chuyện thì cứ lan man. Ra nhà hát, nhờ Alex ngó qua, rồi mang tấm hình tới cho Sơn. Bài học, như mọi khi, lại nói về chuyện khác.",
          "title": "Tấm hình đi lạc",
        },
      },
      "twist": {
        "line": {
          "en": "Alex: the man in this old photo is Tam’s grandfather. Forget Son — this belongs with Tam.",
          "vi": "Alex: người đàn ông trong tấm hình cũ này là ông nội của Tâm đó. Khỏi đưa Sơn — tấm này phải về với Tâm.",
        },
        "step": {
          "itemId": "photo",
          "npcId": "tam",
          "type": "DELIVER",
        },
      },
    },
    {
      "giverNpcId": "bread-vendor",
      "payoff": {
        "en": "Tâm heard the crunch from across the stall? Ninety decibels confirmed. We have a witness now.",
        "vi": "Chú Tâm nghe tiếng giòn từ bên kia sạp hả? Chín chục đề-xi-ben là chuẩn. Giờ có nhân chứng rồi.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "baguette",
          "npcId": "tam",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "This baguette just tested at ninety crunch decibels, bạn — a personal best. Carry it to chú Tâm at the market before the crust drops below eighty.",
          "title": "A ninety-decibel loaf",
        },
        "vi": {
          "description": "Ổ này vừa đo được chín chục đề-xi-ben độ giòn đó bạn — kỷ lục luôn. Mang qua cho chú Tâm ở chợ trước khi vỏ tụt xuống dưới tám chục.",
          "title": "Ổ bánh chín chục đề-xi-ben",
        },
      },
    },
    {
      "giverNpcId": "bread-vendor",
      "scope": "solo",
      "steps": [
        {
          "itemId": "herbs",
          "npcId": "hoa",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring these fresh herbs to cô Hoa at the market.",
          "title": "Herbs for the pho stall",
        },
        "vi": {
          "description": "Mang rau thơm tươi này qua cho cô Hoa ở chợ.",
          "title": "Rau thơm cho sạp phở",
        },
      },
    },
    {
      "giverNpcId": "coffee-friend",
      "scope": "solo",
      "steps": [
        {
          "npcId": "linh",
