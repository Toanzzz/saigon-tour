  "ba": {
    "en": [
      {
        "description": "This old photo has a story, and the story drifts. Walk to the opera, let Alex look it over, then carry the photo to Son. The moral, as always, is about something else.",
        "giverNpcId": "ba",
        "payoff": "Tam teared up? See, that is the moral: a photo always finds its way home, like my stories find the point.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "opera",
            "type": "GO_TO",
          },
          {
            "npcId": "alex",
            "type": "TALK_TO",
          },
          {
            "itemId": "photo",
            "npcId": "son",
            "type": "DELIVER",
          },
        ],
        "title": "The photo that wandered",
        "twist": {
          "line": "Alex: the man in this old photo is Tam’s grandfather. Forget Son — this belongs with Tam.",
          "step": {
            "itemId": "photo",
            "npcId": "tam",
            "type": "DELIVER",
          },
        },
      },
      {
        "description": "Take this old photo to Sơn by the post office. It reminds me of a fish I once lost, which taught me patience. Or was it the fish that was patient?",
        "giverNpcId": "ba",
        "payoff": "Sơn has it? Good. And that, you see, is why you should never trust a tram timetable. Long story.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "photo",
            "npcId": "son",
            "type": "DELIVER",
          },
        ],
        "title": "A photo and a moral",
      },
      {
        "description": "Visit the Opera House and find another side of our city.",
        "giverNpcId": "ba",
        "scope": "solo",
        "steps": [
          {
            "locationId": "opera",
            "type": "GO_TO",
          },
        ],
        "title": "A view along the river",
      },
    ],
    "vi": [
      {
        "description": "Tấm hình cũ này có một câu chuyện, mà chuyện thì cứ lan man. Ra nhà hát, nhờ Alex ngó qua, rồi mang tấm hình tới cho Sơn. Bài học, như mọi khi, lại nói về chuyện khác.",
        "giverNpcId": "ba",
        "payoff": "Tâm rưng rưng hả? Thấy chưa, đó là bài học: tấm hình nào rồi cũng tìm đường về nhà, như chuyện của ông rồi cũng tới chỗ cần tới.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "opera",
            "type": "GO_TO",
          },
          {
            "npcId": "alex",
            "type": "TALK_TO",
          },
          {
            "itemId": "photo",
            "npcId": "son",
            "type": "DELIVER",
          },
        ],
        "title": "Tấm hình đi lạc",
        "twist": {
          "line": "Alex: người đàn ông trong tấm hình cũ này là ông nội của Tâm đó. Khỏi đưa Sơn — tấm này phải về với Tâm.",
          "step": {
            "itemId": "photo",
            "npcId": "tam",
            "type": "DELIVER",
          },
        },
      },
      {
        "description": "Mang tấm hình cũ này cho Sơn ở bưu điện giúp ông. Nó làm ông nhớ con cá ông từng vuột mất, dạy ông tính kiên nhẫn. Hay con cá mới là đứa kiên nhẫn ta?",
        "giverNpcId": "ba",
        "payoff": "Sơn nhận rồi hả? Tốt. Và đó, cháu thấy chưa, là lý do đừng bao giờ tin giờ tàu điện. Chuyện dài lắm.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "photo",
            "npcId": "son",
            "type": "DELIVER",
          },
        ],
        "title": "Tấm hình và một bài học",
      },
      {
        "description": "Ghé Nhà hát Thành phố và khám phá một góc khác của thành phố.",
        "giverNpcId": "ba",
        "scope": "solo",
        "steps": [
          {
            "locationId": "opera",
            "type": "GO_TO",
          },
        ],
        "title": "Ngắm cảnh dọc sông",
      },
    ],
  },
  "bread-vendor": {
    "en": [
      {
        "description": "This baguette just tested at ninety crunch decibels, bạn — a personal best. Carry it to chú Tâm at the market before the crust drops below eighty.",
        "giverNpcId": "bread-vendor",
        "payoff": "Tâm heard the crunch from across the stall? Ninety decibels confirmed. We have a witness now.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "baguette",
            "npcId": "tam",
            "type": "DELIVER",
          },
        ],
        "title": "A ninety-decibel loaf",
