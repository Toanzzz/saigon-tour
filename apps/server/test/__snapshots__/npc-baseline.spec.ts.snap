  "hoa": {
    "en": [
      {
        "description": "A three-bowl problem, con: duck into the alley, ask Mai where lunch landed, then rush this broth to Linh in the park while it is still a three-bowl broth.",
        "giverNpcId": "hoa",
        "payoff": "The lantern crew cleared the pot? A three-bowl problem, solved in one pour.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "alley",
            "type": "GO_TO",
          },
          {
            "npcId": "mai",
            "type": "TALK_TO",
          },
          {
            "itemId": "broth",
            "npcId": "linh",
            "type": "DELIVER",
          },
        ],
        "title": "A three-bowl delivery, con",
        "twist": {
          "line": "Mai: Linh’s lunch moved to Vy’s lantern crew — they are starving over there. Take the broth to Vy instead.",
          "step": {
            "itemId": "broth",
            "npcId": "vy",
            "type": "DELIVER",
          },
        },
      },
      {
        "description": "Chị Linh sounds like a two-bowl problem, con. Carry this broth to her in the park before it cools to a one-bowl mood.",
        "giverNpcId": "hoa",
        "payoff": "Linh smiled? Good. I had her down as a two-bowl problem; turns out one bowl did it.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "broth",
            "npcId": "linh",
            "type": "DELIVER",
          },
        ],
        "title": "A two-bowl problem",
      },
      {
        "description": "Bring these fresh herbs to Linh in the park.",
        "giverNpcId": "hoa",
        "scope": "solo",
        "steps": [
          {
            "itemId": "herbs",
            "npcId": "linh",
            "type": "DELIVER",
          },
        ],
        "title": "Fresh herbs for a neighbor",
      },
    ],
    "vi": [
      {
        "description": "Chuyện cỡ ba tô đó con: ghé vô hẻm, hỏi Mai bữa trưa dời đi đâu, rồi mang tô nước lèo này ra công viên cho chị Linh khi còn nóng cỡ ba tô.",
        "giverNpcId": "hoa",
        "payoff": "Nhóm lồng đèn húp sạch nồi hả? Chuyện cỡ ba tô, một lần rót là xong.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "alley",
            "type": "GO_TO",
          },
          {
            "npcId": "mai",
            "type": "TALK_TO",
          },
          {
            "itemId": "broth",
            "npcId": "linh",
            "type": "DELIVER",
          },
        ],
        "title": "Chuyện giao cỡ ba tô, con",
        "twist": {
          "line": "Mai: bữa trưa của chị Linh dời qua nhóm làm lồng đèn của Vy rồi — tụi nó đói lả bên đó. Mang nước lèo qua cho Vy đi.",
          "step": {
            "itemId": "broth",
            "npcId": "vy",
            "type": "DELIVER",
          },
        },
      },
      {
        "description": "Chị Linh nghe như chuyện cỡ hai tô đó con. Mang tô nước lèo này ra công viên cho chị ấy trước khi nguội còn cỡ một tô.",
        "giverNpcId": "hoa",
        "payoff": "Chị Linh cười hả? Tốt. Cô tưởng cỡ hai tô, ai dè một tô là xong.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "broth",
            "npcId": "linh",
            "type": "DELIVER",
          },
        ],
        "title": "Chuyện cỡ hai tô",
      },
      {
        "description": "Mang rau thơm này đến cho chị Linh ở công viên.",
        "giverNpcId": "hoa",
        "scope": "solo",
        "steps": [
          {
            "itemId": "herbs",
            "npcId": "linh",
            "type": "DELIVER",
          },
        ],
        "title": "Rau thơm cho hàng xóm",
      },
    ],
  },
  "linh": {
    "en": [
      {
        "description": "I am appointing you Deputy Invitations Officer. Report to the market, recruit Cô Hoa to the committee, then deliver this invitation postcard to Mai for the neighborhood lunch.",
        "giverNpcId": "linh",
        "payoff": "Thao accepted the post? Excellent. Consider yourself promoted to Head of Invitations.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "market",
            "type": "GO_TO",
          },
          {
            "npcId": "hoa",
            "type": "TALK_TO",
          },
          {
            "itemId": "postcard",
            "npcId": "mai",
            "type": "DELIVER",
          },
        ],
        "title": "Deputy Invitations Officer",
        "twist": {
          "line": "Hoa: Mai is not on the guest list — she is the guest list. Give the invite to Thao; she runs entertainment.",
          "step": {
            "itemId": "postcard",
            "npcId": "thao",
            "type": "DELIVER",
          },
        },
      },
      {
        "description": "I am appointing you Deputy Herb Logistics Officer. Your first duty: deliver these herbs to Cô Hoa at the market. Badge pending.",
        "giverNpcId": "linh",
        "payoff": "Flawless logistics. I am promoting you to Senior Deputy Herb Logistics Officer, effective immediately.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "herbs",
            "npcId": "hoa",
            "type": "DELIVER",
          },
        ],
        "title": "Deputy Herb Logistics Officer",
      },
      {
        "description": "Visit the market and invite Ms. Hoa to our neighborhood lunch.",
        "giverNpcId": "linh",
        "scope": "solo",
        "steps": [
          {
            "locationId": "market",
            "type": "GO_TO",
          },
          {
            "npcId": "hoa",
            "type": "TALK_TO",
          },
        ],
        "title": "A community lunch invitation",
      },
    ],
    "vi": [
      {
        "description": "Chị phong em làm Phó ban Thư mời. Ra chợ, mời Cô Hoa vào ban tổ chức, rồi mang tấm bưu thiếp mời này giao cho Mai cho bữa trưa của xóm nghen.",
        "giverNpcId": "linh",
        "payoff": "Thảo nhận nhiệm vụ rồi hả? Tuyệt. Em được thăng làm Trưởng ban Thư mời luôn.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "market",
            "type": "GO_TO",
          },
          {
            "npcId": "hoa",
            "type": "TALK_TO",
          },
          {
            "itemId": "postcard",
            "npcId": "mai",
            "type": "DELIVER",
          },
        ],
        "title": "Phó ban Thư mời",
        "twist": {
          "line": "Hoa: Mai đâu nằm trong danh sách khách — Mai chính là danh sách khách đó. Đưa thư mời cho Thảo đi, Thảo lo văn nghệ.",
          "step": {
            "itemId": "postcard",
            "npcId": "thao",
            "type": "DELIVER",
          },
        },
      },
      {
        "description": "Chị bổ nhiệm bạn làm Phó phòng Hậu cần Rau thơm. Nhiệm vụ đầu tiên: mang rau thơm này cho Cô Hoa ở chợ. Huy hiệu sẽ có sau.",
        "giverNpcId": "linh",
        "payoff": "Hậu cần hoàn hảo. Chị thăng chức bạn lên Phó phòng Cấp cao Hậu cần Rau thơm, có hiệu lực ngay.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "herbs",
            "npcId": "hoa",
            "type": "DELIVER",
          },
        ],
        "title": "Phó phòng Hậu cần Rau thơm",
      },
      {
        "description": "Ghé chợ và mời cô Hoa đến bữa trưa chung của xóm.",
        "giverNpcId": "linh",
        "scope": "solo",
        "steps": [
