      ],
      "name": "Ông Ba",
      "role": "Người đạp xích lô và kể chuyện",
    },
  },
  "bread-vendor": {
    "en": {
      "idleLine": "Hello! I'm the sandwich vendor. How is your walk today?",
      "knowledge": [
