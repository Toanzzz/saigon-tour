  "river-jogger": {
    "en": [
      {
        "description": "Quick — bạn — take this — banana — to bác Ba — by the river. But keep pace, do not — slow down, or it — counts as a — rest day. Go, go.",
        "giverNpcId": "river-jogger",
        "payoff": "Bác Ba — has the banana! Thanks — bạn. One errand — across the line. Take a breath — that counts too.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "banana",
            "npcId": "ba",
            "type": "DELIVER",
          },
        ],
        "title": "Keep pace with the banana",
      },
      {
        "description": "Bring these herbs to chị Linh in the park.",
        "giverNpcId": "river-jogger",
        "payoff": "Linh — has the herbs! Thanks — bạn. Park lunch — is one step closer. Good pace — good neighbor.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "herbs",
            "npcId": "linh",
            "type": "DELIVER",
          },
        ],
        "title": "Herbs on the way to the park",
      },
    ],
    "vi": [
      {
        "description": "Nhanh — bạn — mang — trái chuối — này cho — bác Ba — bên sông. Mà giữ nhịp, đừng — chậm lại, không thì — tính là — ngày nghỉ. Chạy, chạy.",
        "giverNpcId": "river-jogger",
        "payoff": "Bác Ba — có chuối rồi! Cảm ơn — bạn nha. Một chuyến giao — về đích. Nghỉ lấy hơi — cũng tính mà.",
        "scope": "solo",
        "steps": [
