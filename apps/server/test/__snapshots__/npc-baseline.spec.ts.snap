  "son": {
    "en": [
      {
        "description": "I wrote a postcard. It opens, "Dear River, you looked tired today." Walk to the river, ask Ong Ba to hear it out, then carry the postcard to Mai.",
        "giverNpcId": "son",
        "payoff": "Thao read it to the river as a song? Dear River, you have a voice now. Yours, Son.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "river",
            "type": "GO_TO",
          },
          {
            "npcId": "ba",
            "type": "TALK_TO",
          },
          {
            "itemId": "postcard",
            "npcId": "mai",
            "type": "DELIVER",
          },
        ],
        "title": "Dear River, you looked tired",
        "twist": {
          "line": "Ba: the river cannot read, you know. But Thao sings to it every evening — give the postcard to her.",
          "step": {
            "itemId": "postcard",
            "npcId": "thao",
            "type": "DELIVER",
          },
        },
      },
      {
        "description": "Deliver this postcard to Ông Ba by the river. It is addressed to the river itself: "Dear River, you looked tired today. Rest up. Warmly, Sơn."",
        "giverNpcId": "son",
        "payoff": "Ông Ba read it to the river out loud. The river said nothing, which Sơn took as deep agreement.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "postcard",
            "npcId": "ba",
            "type": "DELIVER",
          },
        ],
        "title": "Dear River, you looked tired today",
      },
      {
        "description": "Visit the riverside to bring back a little inspiration.",
        "giverNpcId": "son",
        "scope": "solo",
        "steps": [
          {
            "locationId": "river",
            "type": "GO_TO",
          },
        ],
        "title": "Room for a river view",
      },
      {
        "description": "Dear Reader: I hid my favorite hall in a riddle. Guess where it stands, or let a neighbor or a cyclo read it aloud.",
        "giverNpcId": "son",
        "payoff": "You read the riddle like a postcard. Dear You: nicely done. It wrote back this time.",
        "riddle": {
          "text": "A vaulted hall where old clocks pretend to be windows and the whole city mails its small stories. Begin where the letters wait.",
        },
        "scope": "solo",
        "steps": [
          {
            "locationId": "postoffice",
            "type": "GO_TO",
          },
        ],
        "title": "A riddle for the letters",
      },
    ],
    "vi": [
      {
        "description": "Mình viết một tấm bưu thiếp. Mở đầu là: "Sông ơi, bữa nay trông mệt quá." Ra bờ sông, nhờ Ông Ba nghe thử, rồi mang tấm thiếp tới cho Mai.",
        "giverNpcId": "son",
        "payoff": "Thảo hát tấm thiếp cho dòng sông nghe hả? Sông ơi, giờ sông có giọng rồi đó. Thương, Sơn.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "river",
            "type": "GO_TO",
          },
          {
            "npcId": "ba",
            "type": "TALK_TO",
          },
          {
            "itemId": "postcard",
            "npcId": "mai",
            "type": "DELIVER",
          },
        ],
        "title": "Sông ơi, bữa nay trông mệt",
        "twist": {
          "line": "Ba: sông đâu biết đọc đâu con. Nhưng chiều nào Thảo cũng hát cho nó nghe — đưa tấm thiếp cho Thảo đi.",
          "step": {
            "itemId": "postcard",
            "npcId": "thao",
            "type": "DELIVER",
          },
        },
      },
      {
        "description": "Mang tấm bưu thiếp này cho Ông Ba ở bờ sông. Nó gửi cho chính dòng sông: "Gửi Dòng Sông, hôm nay trông mệt quá. Nghỉ ngơi nhé. Thân, Sơn."",
        "giverNpcId": "son",
        "payoff": "Ông Ba đọc to cho dòng sông nghe. Dòng sông không nói gì, mà Sơn hiểu đó là sự đồng tình sâu sắc.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "postcard",
            "npcId": "ba",
            "type": "DELIVER",
          },
        ],
        "title": "Gửi Dòng Sông, hôm nay trông mệt quá",
      },
      {
        "description": "Ghé bờ sông để mang về chút cảm hứng.",
        "giverNpcId": "son",
        "scope": "solo",
        "steps": [
          {
            "locationId": "river",
            "type": "GO_TO",
          },
        ],
        "title": "Chỗ cho cảnh sông",
      },
      {
        "description": "Gửi bạn đọc: mình giấu gian sảnh mình thích trong một câu đố. Đoán xem nó ở đâu, hoặc để hàng xóm hay bác xích lô đọc giúp.",
        "giverNpcId": "son",
        "payoff": "Bạn đọc câu đố như đọc bưu thiếp. Gửi bạn: giỏi lắm. Lần này nó có hồi âm đó.",
        "riddle": {
          "text": "Gian sảnh mái vòm, mấy cái đồng hồ cũ giả làm cửa sổ, cả thành phố gửi những mẩu chuyện nhỏ ở đó. Bắt đầu nơi thư đang chờ.",
        },
        "scope": "solo",
        "steps": [
          {
            "locationId": "postoffice",
            "type": "GO_TO",
          },
        ],
        "title": "Câu đố cho những lá thư",
      },
    ],
  },
  "square-tourist": {
    "en": [
      {
        "description": "My 1998 map swears the river is this way, bạn, which means it is actually City Hall. Take this postcard to chị Vy there — if you reach water, we are both lost.",
        "giverNpcId": "square-tourist",
        "payoff": "You found Vy at City Hall, not the river? See, the 1998 map is never wrong — it just rounds up.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "postcard",
            "npcId": "vy",
            "type": "DELIVER",
          },
        ],
        "title": "Where the map says the river is",
      },
      {
        "description": "Bring this photo to anh Sơn at the Central Post Office.",
        "giverNpcId": "square-tourist",
        "scope": "solo",
        "steps": [
          {
            "itemId": "photo",
            "npcId": "son",
            "type": "DELIVER",
          },
        ],
        "title": "A photo for the post office",
      },
      {
        "description": "I am proudly lost, so I made a riddle about a neighbor instead. Guess who, or let a neighbor or a cyclo say the name.",
        "giverNpcId": "square-tourist",
        "payoff": "You found them without the map. I will note this landmark the way I find everything: by accident.",
        "riddle": {
          "text": "Find the neighbor who gives every paper lantern a dramatic name before dusk. My 1998 map is no help; ask them to point.",
        },
        "scope": "solo",
        "steps": [
          {
            "npcId": "vy",
            "type": "TALK_TO",
          },
        ],
        "title": "A riddle, map optional",
      },
    ],
    "vi": [
      {
        "description": "Bản đồ 1998 của mình thề đây là hướng bờ sông, bạn ơi, nghĩa là thật ra là Tòa Thị Chính. Mang tấm bưu thiếp này cho chị Vy ở đó — nếu bạn ra tới mé nước thì cả hai cùng lạc.",
        "giverNpcId": "square-tourist",
        "payoff": "Bạn gặp chị Vy ở Tòa Thị Chính chứ không phải bờ sông hả? Thấy chưa, bản đồ 1998 không sai bao giờ — nó chỉ làm tròn thôi.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "postcard",
            "npcId": "vy",
            "type": "DELIVER",
          },
        ],
        "title": "Chỗ bản đồ ghi là bờ sông",
      },
      {
        "description": "Mang tấm ảnh này đến cho anh Sơn ở Bưu điện Trung tâm.",
        "giverNpcId": "square-tourist",
        "scope": "solo",
        "steps": [
          {
            "itemId": "photo",
            "npcId": "son",
            "type": "DELIVER",
          },
        ],
        "title": "Tấm ảnh cho bưu điện",
      },
      {
        "description": "Tôi lạc đường một cách tự hào, nên đố bạn về một người hàng xóm. Đoán xem là ai, hoặc để hàng xóm hay bác xích lô nói tên.",
        "giverNpcId": "square-tourist",
        "payoff": "Bạn tìm ra mà chẳng cần bản đồ. Tôi sẽ ghi lại cột mốc này theo cách tôi tìm mọi thứ: tình cờ.",
        "riddle": {
          "text": "Tìm người hàng xóm đặt cho mỗi chiếc lồng đèn giấy một cái tên thật kịch tính trước khi trời tối. Tấm bản đồ 1998 của tôi chịu; nhờ họ chỉ đường.",
        },
        "scope": "solo",
        "steps": [
          {
            "npcId": "vy",
            "type": "TALK_TO",
          },
        ],
        "title": "Câu đố, khỏi cần bản đồ",
      },
    ],
  },
  "student": {
