    "vi": [
      {
        "description": "Ổ này vừa đo được chín chục đề-xi-ben độ giòn đó bạn — kỷ lục luôn. Mang qua cho chú Tâm ở chợ trước khi vỏ tụt xuống dưới tám chục.",
        "giverNpcId": "bread-vendor",
        "payoff": "Chú Tâm nghe tiếng giòn từ bên kia sạp hả? Chín chục đề-xi-ben là chuẩn. Giờ có nhân chứng rồi.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "baguette",
            "npcId": "tam",
            "type": "DELIVER",
          },
        ],
        "title": "Ổ bánh chín chục đề-xi-ben",
      },
      {
        "description": "Mang rau thơm tươi này qua cho cô Hoa ở chợ.",
        "giverNpcId": "bread-vendor",
        "scope": "solo",
        "steps": [
