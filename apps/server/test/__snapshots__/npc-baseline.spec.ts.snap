      "role": "Alley cook",
    },
    "vi": {
      "idleLine": "Chào bạn! Mình là người nấu ăn trong hẻm. Hôm nay bạn đi dạo thế nào?",
      "knowledge": [
        "Mình hay ở quanh hẻm ẩm thực.",
        "Một việc nhỏ cũng giúp hàng xóm gần nhau hơn.",
