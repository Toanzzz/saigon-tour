            "itemId": "photo",
            "npcId": "thao",
            "type": "DELIVER",
          },
        ],
        "title": "Màn xuất hiện bốn sao",
      },
      {
        "description": "Mang tấm bưu thiếp này đến cho anh Alex ở Nhà hát.",
        "giverNpcId": "opera-visitor",
        "payoff": "Anh Alex nhận bưu thiếp rồi! Cảm ơn bạn nha. Giao thiệp chu đáo, lại không giành sân khấu của hàng xóm: đáng nhận xét tốt.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "postcard",
            "npcId": "alex",
