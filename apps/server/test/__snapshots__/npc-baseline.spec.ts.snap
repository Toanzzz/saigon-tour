Your allowed entities: {"home":"park","locations":["park","market","cathedral","cityhall"],"npcs":["hoa","tam","mai","vy","thao"],"items":["herbs","noodles","broth","baguette","banana","postcard"],"gifts":["postcard","banana"]}
