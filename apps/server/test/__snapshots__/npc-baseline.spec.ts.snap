        },
      },
    },
    {
      "giverNpcId": "fruit-vendor",
      "scope": "solo",
      "steps": [
        {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Linh in the park for the fruit vendor, then return.",
          "title": "Ms. Hanh's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến chị Linh ở công viên rồi quay lại nhé.",
          "title": "Lời nhắn của Cô Hạnh",
        },
      },
    },
    {
      "giverNpcId": "hoa",
      "payoff": {
        "en": "The lantern crew cleared the pot? A three-bowl problem, solved in one pour.",
        "vi": "Nhóm lồng đèn húp sạch nồi hả? Chuyện cỡ ba tô, một lần rót là xong.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "alley",
          "type": "GO_TO",
        },
        {
          "npcId": "mai",
          "type": "TALK_TO",
        },
        {
          "itemId": "broth",
          "npcId": "linh",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "A three-bowl problem, con: duck into the alley, ask Mai where lunch landed, then rush this broth to Linh in the park while it is still a three-bowl broth.",
          "title": "A three-bowl delivery, con",
        },
        "vi": {
          "description": "Chuyện cỡ ba tô đó con: ghé vô hẻm, hỏi Mai bữa trưa dời đi đâu, rồi mang tô nước lèo này ra công viên cho chị Linh khi còn nóng cỡ ba tô.",
          "title": "Chuyện giao cỡ ba tô, con",
        },
      },
      "twist": {
        "line": {
          "en": "Mai: Linh’s lunch moved to Vy’s lantern crew — they are starving over there. Take the broth to Vy instead.",
          "vi": "Mai: bữa trưa của chị Linh dời qua nhóm làm lồng đèn của Vy rồi — tụi nó đói lả bên đó. Mang nước lèo qua cho Vy đi.",
        },
        "step": {
          "itemId": "broth",
          "npcId": "vy",
          "type": "DELIVER",
        },
      },
    },
    {
      "giverNpcId": "hoa",
      "payoff": {
        "en": "Linh smiled? Good. I had her down as a two-bowl problem; turns out one bowl did it.",
        "vi": "Chị Linh cười hả? Tốt. Cô tưởng cỡ hai tô, ai dè một tô là xong.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "broth",
          "npcId": "linh",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Chị Linh sounds like a two-bowl problem, con. Carry this broth to her in the park before it cools to a one-bowl mood.",
          "title": "A two-bowl problem",
        },
        "vi": {
          "description": "Chị Linh nghe như chuyện cỡ hai tô đó con. Mang tô nước lèo này ra công viên cho chị ấy trước khi nguội còn cỡ một tô.",
          "title": "Chuyện cỡ hai tô",
        },
      },
    },
    {
      "giverNpcId": "hoa",
      "scope": "solo",
      "steps": [
        {
          "itemId": "herbs",
          "npcId": "linh",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring these fresh herbs to Linh in the park.",
          "title": "Fresh herbs for a neighbor",
        },
        "vi": {
          "description": "Mang rau thơm này đến cho chị Linh ở công viên.",
          "title": "Rau thơm cho hàng xóm",
        },
      },
    },
    {
      "giverNpcId": "linh",
      "scope": "solo",
      "steps": [
        {
          "locationId": "market",
          "type": "GO_TO",
        },
        {
          "npcId": "hoa",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Visit the market and invite Ms. Hoa to our neighborhood lunch.",
          "title": "A community lunch invitation",
        },
        "vi": {
          "description": "Ghé chợ và mời cô Hoa đến bữa trưa chung của xóm.",
          "title": "Lời mời ăn trưa của xóm",
        },
      },
    },
    {
      "giverNpcId": "linh",
      "payoff": {
        "en": "Flawless logistics. I am promoting you to Senior Deputy Herb Logistics Officer, effective immediately.",
        "vi": "Hậu cần hoàn hảo. Chị thăng chức bạn lên Phó phòng Cấp cao Hậu cần Rau thơm, có hiệu lực ngay.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "herbs",
          "npcId": "hoa",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "I am appointing you Deputy Herb Logistics Officer. Your first duty: deliver these herbs to Cô Hoa at the market. Badge pending.",
          "title": "Deputy Herb Logistics Officer",
        },
        "vi": {
          "description": "Chị bổ nhiệm bạn làm Phó phòng Hậu cần Rau thơm. Nhiệm vụ đầu tiên: mang rau thơm này cho Cô Hoa ở chợ. Huy hiệu sẽ có sau.",
          "title": "Phó phòng Hậu cần Rau thơm",
        },
      },
    },
    {
      "giverNpcId": "linh",
      "payoff": {
        "en": "Thao accepted the post? Excellent. Consider yourself promoted to Head of Invitations.",
        "vi": "Thảo nhận nhiệm vụ rồi hả? Tuyệt. Em được thăng làm Trưởng ban Thư mời luôn.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "market",
          "type": "GO_TO",
        },
        {
          "npcId": "hoa",
          "type": "TALK_TO",
        },
        {
          "itemId": "postcard",
          "npcId": "mai",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "I am appointing you Deputy Invitations Officer. Report to the market, recruit Cô Hoa to the committee, then deliver this invitation postcard to Mai for the neighborhood lunch.",
          "title": "Deputy Invitations Officer",
        },
        "vi": {
          "description": "Chị phong em làm Phó ban Thư mời. Ra chợ, mời Cô Hoa vào ban tổ chức, rồi mang tấm bưu thiếp mời này giao cho Mai cho bữa trưa của xóm nghen.",
          "title": "Phó ban Thư mời",
        },
      },
      "twist": {
        "line": {
          "en": "Hoa: Mai is not on the guest list — she is the guest list. Give the invite to Thao; she runs entertainment.",
          "vi": "Hoa: Mai đâu nằm trong danh sách khách — Mai chính là danh sách khách đó. Đưa thư mời cho Thảo đi, Thảo lo văn nghệ.",
        },
        "step": {
          "itemId": "postcard",
          "npcId": "thao",
          "type": "DELIVER",
        },
      },
    },
    {
      "giverNpcId": "mai",
      "scope": "solo",
      "steps": [
        {
          "itemId": "coffee",
          "npcId": "hoa",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Take this coffee across the market to Ms. Hoa.",
          "title": "Coffee for Ms. Hoa",
        },
        "vi": {
          "description": "Mang ly cà phê này qua chợ cho cô Hoa.",
          "title": "Cà phê cho cô Hoa",
        },
      },
    },
    {
      "giverNpcId": "mai",
      "payoff": {
        "en": "Son wrote tasting notes back? A postcard to a coffee? Finally, a reviewer with range.",
        "vi": "Sơn viết lại cảm nhận hả? Viết bưu thiếp cho ly cà phê luôn? Cuối cùng cũng gặp người sành điệu.",
      },
      "scope": "solo",
      "steps": [
        {
          "marketItemId": "banana",
          "type": "BUY",
        },
        {
          "npcId": "hoa",
          "type": "TALK_TO",
        },
        {
          "itemId": "coffee",
          "npcId": "hoa",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "First, a banana from the market as a palate cleanser. Then check in with Cô Hoa and hand her this cà phê sữa đá. Tasting notes: caramel, morning market, and a brave little bitterness.",
          "title": "Tasting notes: a palate cleanser",
        },
        "vi": {
          "description": "Trước hết, mua một trái chuối ngoài chợ để súc miệng cái đã. Rồi ghé Cô Hoa và đưa cô ly cà phê sữa đá này. Hương vị: caramel, chợ sớm, và một chút đắng gan lì.",
          "title": "Hương vị: món súc miệng",
        },
      },
      "twist": {
        "line": {
          "en": "Hoa: con, I am a pho person, not a coffee person. Give it to Son — he reviews everything.",
          "vi": "Hoa: con ơi, cô là người của phở chớ đâu phải cà phê. Đưa cho Sơn đi — cái gì nó cũng chấm điểm hết.",
        },
        "step": {
          "itemId": "coffee",
          "npcId": "son",
          "type": "DELIVER",
        },
      },
    },
    {
      "giverNpcId": "mai",
      "payoff": {
        "en": "Hoa said it tastes like coffee? Finally, an honest review. Five stars.",
        "vi": "Cô Hoa bảo nó có vị cà phê hả? Cuối cùng cũng có một đánh giá thành thật. Năm sao.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "coffee",
          "npcId": "hoa",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Carry this cà phê sữa đá to Cô Hoa. Tasting notes: caramel, a hint of afternoon rain, and quiet ambition. Do not shake the ambition out.",
          "title": "Tasting notes: caramel, rain, ambition",
        },
        "vi": {
          "description": "Mang ly cà phê sữa đá này tới Cô Hoa. Hương vị: caramel, chút mưa chiều, và một ít hoài bão lặng lẽ. Đừng lắc rớt hoài bão nha.",
          "title": "Hương vị: caramel, mưa, hoài bão",
        },
      },
    },
    {
      "giverNpcId": "market-browse",
      "scope": "solo",
      "steps": [
        {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Linh in the park for the market regular, then return.",
          "title": "Ngoc's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến chị Linh ở công viên rồi quay lại nhé.",
          "title": "Lời nhắn của Ngọc",
        },
      },
    },
    {
      "giverNpcId": "market-family",
      "scope": "solo",
      "steps": [
        {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Linh in the park for the family shopper, then return.",
          "title": "Huong's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến chị Linh ở công viên rồi quay lại nhé.",
          "title": "Lời nhắn của Chị Hương",
        },
      },
    },
    {
      "giverNpcId": "market-walk",
      "scope": "solo",
      "steps": [
        {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Linh in the park for the market courier, then return.",
          "title": "Dat's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến chị Linh ở công viên rồi quay lại nhé.",
          "title": "Lời nhắn của Đạt",
        },
      },
    },
    {
      "giverNpcId": "opera-visitor",
      "payoff": {
        "en": "Thảo took the photo and your entrance held? Four stars, bạn. The pigeons wanted five; they always overrate.",
        "vi": "Chị Thảo nhận ảnh mà màn xuất hiện của bạn vững hả? Bốn sao đó bạn. Bồ câu đòi năm; tụi nó lúc nào cũng chấm lố.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "photo",
          "npcId": "thao",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "I am filing tonight’s review, bạn. Carry this photo to chị Thảo at the Opera House and make your entrance count — I am scoring it, and the pigeons are an expert panel.",
          "title": "A four-star entrance",
        },
        "vi": {
          "description": "Mình đang viết bài bình tối nay, bạn. Mang tấm ảnh này cho chị Thảo ở Nhà hát và xuất hiện cho ra dáng — mình chấm điểm đó, mà ban giám khảo bồ câu khó tính lắm.",
          "title": "Màn xuất hiện bốn sao",
        },
      },
    },
    {
      "giverNpcId": "opera-visitor",
      "scope": "solo",
      "steps": [
        {
          "itemId": "postcard",
          "npcId": "alex",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring this postcard to anh Alex at the Opera House.",
          "title": "A note for a fellow regular",
        },
        "vi": {
          "description": "Mang tấm bưu thiếp này đến cho anh Alex ở Nhà hát.",
          "title": "Lời nhắn cho người quen",
        },
      },
    },
    {
      "giverNpcId": "opera-visitor",
      "payoff": {
        "en": "You found my critic without a program note. Four stars for the entrance.",
        "vi": "Bạn tìm ra nhà phê bình của mình mà chẳng cần tờ chương trình. Bốn sao cho màn vào cửa.",
      },
      "riddle": {
        "text": {
          "en": "Find the neighbor who freezes a single moment and swears the pigeon planned the photobomb. Ask them for the review.",
          "vi": "Tìm người hàng xóm hay bắt lấy một khoảnh khắc rồi thề là con bồ câu cố tình phá ảnh. Hỏi họ lời nhận xét nhé.",
        },
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "alex",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "I turned tonight’s review into a riddle about a neighbor. Deduce who, or let a neighbor or a cyclo name them.",
          "title": "A riddle for opening night",
        },
        "vi": {
          "description": "Mình biến bài nhận xét tối nay thành câu đố về một người hàng xóm. Đoán xem là ai, hoặc để hàng xóm hay bác xích lô gọi tên.",
          "title": "Câu đố cho đêm khai diễn",
        },
      },
    },
    {
      "giverNpcId": "park-reader",
      "scope": "solo",
      "steps": [
        {
          "npcId": "hoa",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Ms. Hoa at the market for the park reader, then return.",
          "title": "Mr. Phuc's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến cô Hoa ở chợ rồi quay lại nhé.",
          "title": "Lời nhắn của Chú Phúc",
        },
      },
    },
    {
      "giverNpcId": "park-stretch",
      "payoff": {
        "en": "Linh got the banana and your shoulders held the whole way? That is a full set, bạn. Gains secured.",
        "vi": "Chị Linh nhận chuối mà vai bạn giữ nguyên tới nơi hả? Trọn một set đó bạn. Lên cơ chắc rồi.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "banana",
          "npcId": "linh",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Perfect rep, bạn: take this banana to chị Linh in the park, but carry it at shoulder height the whole way — for the gains. Counts as a set.",
          "title": "A shoulder-height delivery",
        },
        "vi": {
          "description": "Một hiệp hoàn hảo nè bạn: mang trái chuối này cho chị Linh ở công viên, mà phải xách ngang vai suốt đường — cho lên cơ. Tính là một set.",
          "title": "Giao hàng ngang vai",
        },
      },
    },
    {
      "giverNpcId": "park-stretch",
      "scope": "solo",
      "steps": [
        {
          "itemId": "herbs",
          "npcId": "linh",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring these herbs to chị Linh in the park.",
          "title": "Fresh herbs for the park lunch",
        },
        "vi": {
          "description": "Mang rau thơm này đến cho chị Linh ở công viên.",
          "title": "Rau thơm cho bữa trưa công viên",
        },
      },
    },
    {
      "giverNpcId": "plaza-friends",
      "scope": "solo",
      "steps": [
        {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Linh in the park for the plaza neighbor, then return.",
          "title": "Ha's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến chị Linh ở công viên rồi quay lại nhé.",
          "title": "Lời nhắn của Hà",
        },
      },
    },
    {
      "giverNpcId": "plaza-stroll",
      "scope": "solo",
      "steps": [
        {
          "itemId": "photo",
          "npcId": "vy",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring this photo to chị Vy at City Hall.",
          "title": "A keepsake for a neighbor",
        },
        "vi": {
          "description": "Mang tấm ảnh này đến cho chị Vy ở Tòa Thị Chính.",
          "title": "Kỷ vật cho hàng xóm",
        },
      },
    },
    {
      "giverNpcId": "plaza-stroll",
      "payoff": {
        "en": "Alex clapped at your line, bạn? Then the verse found its stage. Bravo — encore tomorrow.",
        "vi": "Anh Alex vỗ tay khi bạn xuống câu hả? Vậy là câu ngâm đã tìm được sân khấu. Hoan hô — mai diễn lại nhé.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "postcard",
          "npcId": "alex",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "I have penned a single trembling verse on this postcard, bạn. Carry it to anh Alex at the Opera House and, when you hand it over, deliver the line out loud — gently, like the lamps are listening.",
          "title": "Deliver the line",
        },
        "vi": {
          "description": "Mình đã đề một câu ngâm run run lên tấm bưu thiếp này, bạn ơi. Mang qua cho anh Alex ở Nhà hát, và khi trao thì xuống câu thành tiếng — nhẹ thôi, như thể đèn đang lắng nghe.",
          "title": "Xuống câu giùm nhé",
        },
      },
    },
    {
      "giverNpcId": "postcard-reader",
      "payoff": {
        "en": "Sơn read the haiku aloud, bạn? Then the little boat reached shore. The stamp may retire, satisfied.",
        "vi": "Anh Sơn đọc bài haiku lên hả bạn? Vậy là con thuyền nhỏ đã tới bến. Con tem giờ có thể an lòng nghỉ hưu.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "postcard",
          "npcId": "son",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "I inked a haiku beside the stamp, bạn: blue stamp, patient glue / a small boat waits for the tide / carry it to shore. Take the postcard to anh Sơn at the post office.",
          "title": "A haiku for the stamp",
        },
        "vi": {
          "description": "Mình đề một bài haiku cạnh con tem, bạn ơi: tem xanh, keo kiên nhẫn / con thuyền nhỏ đợi con nước lên / mang tới bến giùm. Đưa tấm bưu thiếp cho anh Sơn ở bưu điện nhé.",
          "title": "Bài haiku cho con tem",
        },
      },
    },
    {
      "giverNpcId": "postcard-reader",
      "scope": "solo",
      "steps": [
        {
          "itemId": "photo",
          "npcId": "vy",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring this photo to chị Vy at City Hall.",
          "title": "A photo for City Hall",
        },
        "vi": {
          "description": "Mang tấm ảnh này đến cho chị Vy ở Tòa Thị Chính.",
          "title": "Tấm ảnh cho Tòa Thị Chính",
        },
      },
    },
    {
      "giverNpcId": "postcard-reader",
      "payoff": {
        "en": "Delivered to the right poet. Stamp, address, and riddle: all three finally rhyme.",
        "vi": "Giao đúng cho nhà thơ rồi. Con tem, địa chỉ, và câu đố: cuối cùng cả ba cũng vần.",
      },
      "riddle": {
        "text": {
          "en": "Carry this card to the neighbor who mails letters to the river and never waits for a reply. He will know the stamp.",
          "vi": "Mang tấm thiệp này đến người hàng xóm hay gửi thư cho dòng sông mà chẳng bao giờ chờ hồi âm. Anh ấy sẽ biết con tem.",
        },
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "postcard",
          "npcId": "son",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "A haiku for a hidden address. Work out who receives this postcard, or let a neighbor or a cyclo tell you.",
          "title": "A stamp-poem riddle",
        },
        "vi": {
          "description": "Một bài haiku cho địa chỉ còn giấu. Đoán xem ai nhận tấm bưu thiếp này, hoặc để hàng xóm hay bác xích lô mách cho.",
          "title": "Câu đố thơ con tem",
        },
      },
    },
    {
      "giverNpcId": "river-jogger",
      "scope": "solo",
      "steps": [
        {
          "itemId": "herbs",
          "npcId": "linh",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring these herbs to chị Linh in the park.",
          "title": "Herbs on the way to the park",
        },
        "vi": {
          "description": "Mang rau thơm này đến cho chị Linh ở công viên.",
          "title": "Rau thơm trên đường ra công viên",
        },
      },
    },
    {
      "giverNpcId": "river-jogger",
      "payoff": {
        "en": "Bác Ba — got it — and you — kept pace? Then today — is not — a rest day. Huff — nice work, bạn.",
        "vi": "Bác Ba — nhận rồi — mà bạn — giữ nhịp hả? Vậy hôm nay — không phải — ngày nghỉ. Thở — giỏi lắm bạn.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "banana",
          "npcId": "ba",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Quick — bạn — take this — banana — to bác Ba — by the river. But keep pace, do not — slow down, or it — counts as a — rest day. Go, go.",
          "title": "Keep pace with the banana",
        },
        "vi": {
          "description": "Nhanh — bạn — mang — trái chuối — này cho — bác Ba — bên sông. Mà giữ nhịp, đừng — chậm lại, không thì — tính là — ngày nghỉ. Chạy, chạy.",
          "title": "Giữ nhịp với trái chuối",
        },
      },
    },
    {
      "giverNpcId": "riverside-friends",
      "scope": "solo",
      "steps": [
        {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Linh in the park for the river neighbor, then return.",
          "title": "Nhi's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến chị Linh ở công viên rồi quay lại nhé.",
          "title": "Lời nhắn của Nhi",
        },
      },
    },
    {
      "giverNpcId": "son",
      "payoff": {
        "en": "You read the riddle like a postcard. Dear You: nicely done. It wrote back this time.",
        "vi": "Bạn đọc câu đố như đọc bưu thiếp. Gửi bạn: giỏi lắm. Lần này nó có hồi âm đó.",
      },
      "riddle": {
        "text": {
          "en": "A vaulted hall where old clocks pretend to be windows and the whole city mails its small stories. Begin where the letters wait.",
          "vi": "Gian sảnh mái vòm, mấy cái đồng hồ cũ giả làm cửa sổ, cả thành phố gửi những mẩu chuyện nhỏ ở đó. Bắt đầu nơi thư đang chờ.",
        },
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "postoffice",
          "type": "GO_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Dear Reader: I hid my favorite hall in a riddle. Guess where it stands, or let a neighbor or a cyclo read it aloud.",
          "title": "A riddle for the letters",
        },
        "vi": {
          "description": "Gửi bạn đọc: mình giấu gian sảnh mình thích trong một câu đố. Đoán xem nó ở đâu, hoặc để hàng xóm hay bác xích lô đọc giúp.",
          "title": "Câu đố cho những lá thư",
        },
      },
    },
    {
      "giverNpcId": "son",
      "payoff": {
        "en": "Thao read it to the river as a song? Dear River, you have a voice now. Yours, Son.",
        "vi": "Thảo hát tấm thiếp cho dòng sông nghe hả? Sông ơi, giờ sông có giọng rồi đó. Thương, Sơn.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "river",
          "type": "GO_TO",
        },
        {
          "npcId": "ba",
          "type": "TALK_TO",
        },
        {
          "itemId": "postcard",
          "npcId": "mai",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "I wrote a postcard. It opens, "Dear River, you looked tired today." Walk to the river, ask Ong Ba to hear it out, then carry the postcard to Mai.",
          "title": "Dear River, you looked tired",
        },
        "vi": {
          "description": "Mình viết một tấm bưu thiếp. Mở đầu là: "Sông ơi, bữa nay trông mệt quá." Ra bờ sông, nhờ Ông Ba nghe thử, rồi mang tấm thiếp tới cho Mai.",
          "title": "Sông ơi, bữa nay trông mệt",
        },
      },
      "twist": {
        "line": {
          "en": "Ba: the river cannot read, you know. But Thao sings to it every evening — give the postcard to her.",
          "vi": "Ba: sông đâu biết đọc đâu con. Nhưng chiều nào Thảo cũng hát cho nó nghe — đưa tấm thiếp cho Thảo đi.",
        },
        "step": {
          "itemId": "postcard",
          "npcId": "thao",
          "type": "DELIVER",
        },
      },
    },
    {
      "giverNpcId": "son",
      "payoff": {
        "en": "Ông Ba read it to the river out loud. The river said nothing, which Sơn took as deep agreement.",
        "vi": "Ông Ba đọc to cho dòng sông nghe. Dòng sông không nói gì, mà Sơn hiểu đó là sự đồng tình sâu sắc.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "postcard",
          "npcId": "ba",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Deliver this postcard to Ông Ba by the river. It is addressed to the river itself: "Dear River, you looked tired today. Rest up. Warmly, Sơn."",
          "title": "Dear River, you looked tired today",
        },
        "vi": {
          "description": "Mang tấm bưu thiếp này cho Ông Ba ở bờ sông. Nó gửi cho chính dòng sông: "Gửi Dòng Sông, hôm nay trông mệt quá. Nghỉ ngơi nhé. Thân, Sơn."",
          "title": "Gửi Dòng Sông, hôm nay trông mệt quá",
        },
      },
    },
    {
      "giverNpcId": "son",
      "scope": "solo",
      "steps": [
        {
          "locationId": "river",
          "type": "GO_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Visit the riverside to bring back a little inspiration.",
          "title": "Room for a river view",
        },
        "vi": {
          "description": "Ghé bờ sông để mang về chút cảm hứng.",
          "title": "Chỗ cho cảnh sông",
        },
      },
    },
    {
      "giverNpcId": "square-tourist",
      "scope": "solo",
      "steps": [
        {
          "itemId": "photo",
          "npcId": "son",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring this photo to anh Sơn at the Central Post Office.",
          "title": "A photo for the post office",
        },
        "vi": {
          "description": "Mang tấm ảnh này đến cho anh Sơn ở Bưu điện Trung tâm.",
          "title": "Tấm ảnh cho bưu điện",
        },
      },
    },
    {
      "giverNpcId": "square-tourist",
      "payoff": {
        "en": "You found them without the map. I will note this landmark the way I find everything: by accident.",
        "vi": "Bạn tìm ra mà chẳng cần bản đồ. Tôi sẽ ghi lại cột mốc này theo cách tôi tìm mọi thứ: tình cờ.",
      },
      "riddle": {
        "text": {
          "en": "Find the neighbor who gives every paper lantern a dramatic name before dusk. My 1998 map is no help; ask them to point.",
          "vi": "Tìm người hàng xóm đặt cho mỗi chiếc lồng đèn giấy một cái tên thật kịch tính trước khi trời tối. Tấm bản đồ 1998 của tôi chịu; nhờ họ chỉ đường.",
        },
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "vy",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "I am proudly lost, so I made a riddle about a neighbor instead. Guess who, or let a neighbor or a cyclo say the name.",
          "title": "A riddle, map optional",
        },
        "vi": {
          "description": "Tôi lạc đường một cách tự hào, nên đố bạn về một người hàng xóm. Đoán xem là ai, hoặc để hàng xóm hay bác xích lô nói tên.",
          "title": "Câu đố, khỏi cần bản đồ",
        },
      },
    },
    {
      "giverNpcId": "square-tourist",
      "payoff": {
        "en": "You found Vy at City Hall, not the river? See, the 1998 map is never wrong — it just rounds up.",
        "vi": "Bạn gặp chị Vy ở Tòa Thị Chính chứ không phải bờ sông hả? Thấy chưa, bản đồ 1998 không sai bao giờ — nó chỉ làm tròn thôi.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "postcard",
          "npcId": "vy",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "My 1998 map swears the river is this way, bạn, which means it is actually City Hall. Take this postcard to chị Vy there — if you reach water, we are both lost.",
          "title": "Where the map says the river is",
        },
        "vi": {
          "description": "Bản đồ 1998 của mình thề đây là hướng bờ sông, bạn ơi, nghĩa là thật ra là Tòa Thị Chính. Mang tấm bưu thiếp này cho chị Vy ở đó — nếu bạn ra tới mé nước thì cả hai cùng lạc.",
          "title": "Chỗ bản đồ ghi là bờ sông",
        },
      },
    },
    {
      "giverNpcId": "student",
      "scope": "solo",
      "steps": [
        {
          "npcId": "hoa",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Say hello to Ms. Hoa at the market for the student, then return.",
          "title": "Minh's neighborhood hello",
        },
        "vi": {
          "description": "Gửi lời chào đến cô Hoa ở chợ rồi quay lại nhé.",
          "title": "Lời nhắn của Minh",
        },
      },
    },
    {
      "giverNpcId": "tam",
      "scope": "solo",
      "steps": [
        {
          "npcId": "ba",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Check on Mr. Ba by the river and say hello.",
          "title": "A riverside hello",
        },
        "vi": {
          "description": "Ghé thăm ông Ba bên sông và chào ông một tiếng.",
          "title": "Lời chào bên sông",
        },
      },
    },
    {
      "giverNpcId": "tam",
      "payoff": {
        "en": "Two songs, right? Do not tell me. I will tell everyone it was two songs.",
        "vi": "Hai bài hát đúng không? Đừng nói gì. Để anh khoe với mọi người là đúng hai bài.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "coffee",
          "npcId": "hoa",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Run this cà phê to Cô Hoa by my shortcut. It is exactly two songs long. Three if you hum slowly, which you will.",
          "title": "The two-song shortcut",
        },
        "vi": {
          "description": "Mang ly cà phê này tới Cô Hoa theo đường tắt của anh. Đúng hai bài hát thôi. Ba bài nếu em ngân nga chậm, mà chắc em sẽ vậy.",
          "title": "Đường tắt hai bài hát",
        },
      },
    },
    {
      "giverNpcId": "tam",
      "payoff": {
        "en": "Smooth ride? Do not tell me. I will tell everyone it was smooth.",
        "vi": "Đi êm chứ? Đừng kể anh nghe. Để anh khoe với mọi người là êm ru.",
      },
      "scope": "solo",
      "steps": [
        {
          "npcId": "mai",
          "type": "TALK_TO",
        },
        {
          "itemId": "cake",
          "npcId": "mai",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "My helmet is at the polisher, so I cannot drive this wedding cake myself. Check in with Mai, then carry the cake to her — gently, it is three tiers of trust.",
          "title": "Wedding cake express",
        },
        "vi": {
          "description": "Nón bảo hiểm của anh đang ở tiệm đánh bóng, nên anh không tự chở bánh cưới này được. Ghé Mai một tiếng, rồi mang bánh tới cho chị ấy — nhẹ tay nghen, ba tầng niềm tin đó.",
          "title": "Chuyển phát bánh cưới",
        },
      },
      "twist": {
        "line": {
          "en": "Mai: the wedding moved to the riverside! Ông Ba is the chủ hôn now. Take the cake to him.",
          "vi": "Mai: đám cưới dời ra bờ sông rồi! Ông Ba làm chủ hôn giờ. Mang bánh ra cho ông đi.",
        },
        "step": {
          "itemId": "cake",
          "npcId": "ba",
          "type": "DELIVER",
        },
      },
    },
    {
      "giverNpcId": "thao",
      "payoff": {
        "en": "The chorus landed on the last step to Sơn. I am naming the song after your shoes.",
        "vi": "Điệp khúc rơi đúng vào bước chân cuối tới chỗ Sơn. Mình sẽ đặt tên bài hát theo đôi giày của bạn.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "coffee",
          "npcId": "son",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Bring this coffee to Sơn at the post office. I am composing a tiny ballad about your footsteps; try to walk in a nice rhythm so the chorus works.",
          "title": "A little ballad for the errand",
        },
        "vi": {
          "description": "Mang ly cà phê này cho Sơn ở bưu điện. Mình đang soạn một khúc ballad nhỏ về bước chân bạn; đi nhịp nhàng chút để điệp khúc nghe cho hay nhé.",
          "title": "Khúc ballad nhỏ cho chuyến đi",
        },
      },
    },
    {
      "giverNpcId": "thao",
      "payoff": {
        "en": "You found the echo yourself. Now the ballad has a proper first verse.",
        "vi": "Bạn tự tìm ra tiếng vọng rồi. Giờ khúc ballad đã có đoạn mở đầu đàng hoàng.",
      },
      "riddle": {
        "text": {
          "en": "Two red-brick bell towers keep the square’s best echo. The pigeons only pretend to conduct. Stand where it answers.",
          "vi": "Hai tháp chuông gạch đỏ giữ tiếng vọng đẹp nhất của quảng trường. Mấy chú bồ câu chỉ giả bộ bắt nhịp thôi. Đến nơi nó vọng lại.",
        },
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "cathedral",
          "type": "GO_TO",
        },
      ],
      "text": {
        "en": {
          "description": "I caught a melody in the square and set it as a riddle. Solve where it lives, or let a neighbor or a cyclo tell you.",
          "title": "A riddle for the echo",
        },
        "vi": {
          "description": "Mình bắt được một giai điệu ngoài quảng trường và đố bạn. Đoán xem nó ở đâu, hoặc để hàng xóm hay bác xích lô mách cho.",
          "title": "Câu đố cho tiếng vọng",
        },
      },
    },
    {
      "giverNpcId": "thao",
      "scope": "solo",
      "steps": [
        {
          "locationId": "cathedral",
          "type": "GO_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Listen to the city at the cathedral square.",
          "title": "An echo across the square",
        },
        "vi": {
          "description": "Lắng nghe thành phố ở quảng trường nhà thờ.",
          "title": "Tiếng vọng qua quảng trường",
        },
      },
    },
    {
      "giverNpcId": "thao",
      "payoff": {
        "en": "Linh and her megaphone? That explains the melody — and the key change at dinnertime.",
        "vi": "Linh với cái loa phóng thanh hả? Thảo nào có giai điệu — lại còn đổi tông đúng giờ cơm chiều.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "cathedral",
          "type": "GO_TO",
        },
        {
          "npcId": "son",
          "type": "TALK_TO",
        },
        {
          "npcId": "vy",
          "type": "TALK_TO",
        },
      ],
      "text": {
        "en": {
          "description": "I hear a melody in the square and I must find its source. Go to the cathedral, ask Son what he heard, then find Vy — her lanterns might be humming.",
          "title": "The echo across the square",
        },
        "vi": {
          "description": "Mình nghe một giai điệu vang trong quảng trường và phải tìm cho ra nguồn. Ra nhà thờ, hỏi Sơn nghe được gì, rồi tìm Vy — biết đâu mấy chiếc lồng đèn của bạn ấy đang ngân nga.",
          "title": "Tiếng vọng qua quảng trường",
        },
      },
      "twist": {
        "line": {
          "en": "Son: that was no lantern. The echo was Linh practicing with her megaphone. Go ask her.",
          "vi": "Sơn: lồng đèn gì đâu. Tiếng vọng đó là Linh tập loa phóng thanh đó. Qua hỏi chị ấy đi.",
        },
        "step": {
          "npcId": "linh",
          "type": "TALK_TO",
        },
      },
    },
    {
      "giverNpcId": "vy",
      "payoff": {
        "en": "Alex photographed Pho Moon at dusk? A lantern with its own backstory and a portrait. Immortal.",
        "vi": "Alex chụp "Phở Moon" lúc chạng vạng hả? Một chiếc lồng đèn có cả câu chuyện lẫn tấm chân dung. Bất tử luôn.",
      },
      "scope": "solo",
      "steps": [
        {
          "locationId": "alley",
          "type": "GO_TO",
        },
        {
          "npcId": "hoa",
          "type": "TALK_TO",
        },
        {
          "itemId": "postcard",
          "npcId": "thao",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "A new lantern needs a name and a dramatic backstory. Hang it in the alley, ask Cô Hoa for the name, then send the announcement postcard to Thao.",
          "title": "A lantern needs a name",
        },
        "vi": {
          "description": "Chiếc lồng đèn mới cần một cái tên và một câu chuyện thật kịch tính. Treo nó trong hẻm, nhờ Cô Hoa đặt tên, rồi gửi tấm bưu thiếp thông báo cho Thảo.",
          "title": "Lồng đèn cần một cái tên",
        },
      },
      "twist": {
        "line": {
          "en": "Hoa: I named it "Pho Moon." Thao hates puns, so send the card to Alex — he will photograph it.",
          "vi": "Hoa: cô đặt tên nó là "Phở Moon." Thảo ghét chơi chữ lắm, nên gửi tấm thiệp cho Alex đi — nó sẽ chụp hình cho.",
        },
        "step": {
          "itemId": "postcard",
          "npcId": "alex",
          "type": "DELIVER",
        },
      },
    },
    {
      "giverNpcId": "vy",
      "scope": "solo",
      "steps": [
        {
          "locationId": "alley",
          "type": "GO_TO",
        },
      ],
      "text": {
        "en": {
          "description": "Visit the food alley and look for a welcoming evening corner.",
          "title": "An evening walk",
        },
        "vi": {
          "description": "Ghé hẻm ẩm thực và tìm một góc phố buổi tối thật ấm cúng.",
          "title": "Dạo phố buổi tối",
        },
      },
    },
    {
      "giverNpcId": "vy",
      "payoff": {
        "en": "Mai toasted Phở Moon with the coffee. The lantern has never felt so seen.",
        "vi": "Mai nâng ly cà phê chúc mừng Trăng Phở. Chiếc đèn lồng chưa bao giờ thấy mình được công nhận đến vậy.",
      },
      "scope": "solo",
      "steps": [
        {
          "itemId": "coffee",
          "npcId": "mai",
          "type": "DELIVER",
        },
      ],
      "text": {
        "en": {
          "description": "Take this cà phê to Mai for the lantern crew. Tell her it is for "Phở Moon", the lantern that survived last year's drizzle. A hero deserves caffeine.",
          "title": "Coffee for the lantern crew",
        },
        "vi": {
          "description": "Mang ly cà phê này cho Mai cho đội làm đèn lồng. Nói với chị ấy là dành cho "Trăng Phở", chiếc đèn sống sót qua cơn mưa phùn năm ngoái. Anh hùng thì xứng đáng có cà phê.",
          "title": "Cà phê cho đội đèn lồng",
        },
      },
    },
  ],
