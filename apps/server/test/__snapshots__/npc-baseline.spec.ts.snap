  "tam": {
    "en": [
      {
        "description": "My helmet is at the polisher, so I cannot drive this wedding cake myself. Check in with Mai, then carry the cake to her — gently, it is three tiers of trust.",
        "giverNpcId": "tam",
        "payoff": "Smooth ride? Do not tell me. I will tell everyone it was smooth.",
        "scope": "solo",
        "steps": [
          {
            "npcId": "mai",
            "type": "TALK_TO",
          },
          {
            "itemId": "cake",
            "npcId": "mai",
            "type": "DELIVER",
          },
        ],
        "title": "Wedding cake express",
        "twist": {
          "line": "Mai: the wedding moved to the riverside! Ông Ba is the chủ hôn now. Take the cake to him.",
          "step": {
            "itemId": "cake",
            "npcId": "ba",
            "type": "DELIVER",
          },
        },
      },
      {
        "description": "Run this cà phê to Cô Hoa by my shortcut. It is exactly two songs long. Three if you hum slowly, which you will.",
        "giverNpcId": "tam",
        "payoff": "Two songs, right? Do not tell me. I will tell everyone it was two songs.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "coffee",
            "npcId": "hoa",
            "type": "DELIVER",
          },
        ],
        "title": "The two-song shortcut",
      },
      {
        "description": "Check on Mr. Ba by the river and say hello.",
        "giverNpcId": "tam",
        "scope": "solo",
        "steps": [
          {
            "npcId": "ba",
            "type": "TALK_TO",
          },
        ],
        "title": "A riverside hello",
      },
    ],
    "vi": [
      {
        "description": "Nón bảo hiểm của anh đang ở tiệm đánh bóng, nên anh không tự chở bánh cưới này được. Ghé Mai một tiếng, rồi mang bánh tới cho chị ấy — nhẹ tay nghen, ba tầng niềm tin đó.",
        "giverNpcId": "tam",
        "payoff": "Đi êm chứ? Đừng kể anh nghe. Để anh khoe với mọi người là êm ru.",
        "scope": "solo",
        "steps": [
          {
            "npcId": "mai",
            "type": "TALK_TO",
          },
          {
            "itemId": "cake",
            "npcId": "mai",
            "type": "DELIVER",
          },
        ],
        "title": "Chuyển phát bánh cưới",
        "twist": {
          "line": "Mai: đám cưới dời ra bờ sông rồi! Ông Ba làm chủ hôn giờ. Mang bánh ra cho ông đi.",
          "step": {
            "itemId": "cake",
            "npcId": "ba",
            "type": "DELIVER",
          },
        },
      },
      {
        "description": "Mang ly cà phê này tới Cô Hoa theo đường tắt của anh. Đúng hai bài hát thôi. Ba bài nếu em ngân nga chậm, mà chắc em sẽ vậy.",
        "giverNpcId": "tam",
        "payoff": "Hai bài hát đúng không? Đừng nói gì. Để anh khoe với mọi người là đúng hai bài.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "coffee",
            "npcId": "hoa",
            "type": "DELIVER",
          },
        ],
        "title": "Đường tắt hai bài hát",
      },
      {
        "description": "Ghé thăm ông Ba bên sông và chào ông một tiếng.",
        "giverNpcId": "tam",
        "scope": "solo",
        "steps": [
          {
            "npcId": "ba",
            "type": "TALK_TO",
          },
        ],
        "title": "Lời chào bên sông",
      },
    ],
  },
  "thao": {
    "en": [
      {
        "description": "I hear a melody in the square and I must find its source. Go to the cathedral, ask Son what he heard, then find Vy — her lanterns might be humming.",
        "giverNpcId": "thao",
        "payoff": "Linh and her megaphone? That explains the melody — and the key change at dinnertime.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "cathedral",
            "type": "GO_TO",
          },
          {
            "npcId": "son",
            "type": "TALK_TO",
          },
          {
            "npcId": "vy",
            "type": "TALK_TO",
          },
        ],
        "title": "The echo across the square",
        "twist": {
          "line": "Son: that was no lantern. The echo was Linh practicing with her megaphone. Go ask her.",
          "step": {
            "npcId": "linh",
            "type": "TALK_TO",
          },
        },
      },
      {
        "description": "Bring this coffee to Sơn at the post office. I am composing a tiny ballad about your footsteps; try to walk in a nice rhythm so the chorus works.",
        "giverNpcId": "thao",
        "payoff": "The chorus landed on the last step to Sơn. I am naming the song after your shoes.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "coffee",
            "npcId": "son",
            "type": "DELIVER",
          },
        ],
        "title": "A little ballad for the errand",
      },
      {
        "description": "Listen to the city at the cathedral square.",
        "giverNpcId": "thao",
        "scope": "solo",
        "steps": [
          {
            "locationId": "cathedral",
            "type": "GO_TO",
          },
        ],
        "title": "An echo across the square",
      },
      {
        "description": "I caught a melody in the square and set it as a riddle. Solve where it lives, or let a neighbor or a cyclo tell you.",
        "giverNpcId": "thao",
        "payoff": "You found the echo yourself. Now the ballad has a proper first verse.",
        "riddle": {
          "text": "Two red-brick bell towers keep the square’s best echo. The pigeons only pretend to conduct. Stand where it answers.",
        },
        "scope": "solo",
        "steps": [
          {
            "locationId": "cathedral",
            "type": "GO_TO",
          },
        ],
        "title": "A riddle for the echo",
      },
    ],
    "vi": [
      {
        "description": "Mình nghe một giai điệu vang trong quảng trường và phải tìm cho ra nguồn. Ra nhà thờ, hỏi Sơn nghe được gì, rồi tìm Vy — biết đâu mấy chiếc lồng đèn của bạn ấy đang ngân nga.",
        "giverNpcId": "thao",
        "payoff": "Linh với cái loa phóng thanh hả? Thảo nào có giai điệu — lại còn đổi tông đúng giờ cơm chiều.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "cathedral",
            "type": "GO_TO",
          },
          {
            "npcId": "son",
            "type": "TALK_TO",
          },
          {
            "npcId": "vy",
            "type": "TALK_TO",
          },
        ],
        "title": "Tiếng vọng qua quảng trường",
        "twist": {
          "line": "Sơn: lồng đèn gì đâu. Tiếng vọng đó là Linh tập loa phóng thanh đó. Qua hỏi chị ấy đi.",
          "step": {
            "npcId": "linh",
            "type": "TALK_TO",
          },
        },
      },
      {
        "description": "Mang ly cà phê này cho Sơn ở bưu điện. Mình đang soạn một khúc ballad nhỏ về bước chân bạn; đi nhịp nhàng chút để điệp khúc nghe cho hay nhé.",
        "giverNpcId": "thao",
        "payoff": "Điệp khúc rơi đúng vào bước chân cuối tới chỗ Sơn. Mình sẽ đặt tên bài hát theo đôi giày của bạn.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "coffee",
            "npcId": "son",
            "type": "DELIVER",
          },
        ],
        "title": "Khúc ballad nhỏ cho chuyến đi",
      },
      {
        "description": "Lắng nghe thành phố ở quảng trường nhà thờ.",
        "giverNpcId": "thao",
        "scope": "solo",
        "steps": [
          {
            "locationId": "cathedral",
            "type": "GO_TO",
          },
        ],
        "title": "Tiếng vọng qua quảng trường",
      },
      {
        "description": "Mình bắt được một giai điệu ngoài quảng trường và đố bạn. Đoán xem nó ở đâu, hoặc để hàng xóm hay bác xích lô mách cho.",
        "giverNpcId": "thao",
        "payoff": "Bạn tự tìm ra tiếng vọng rồi. Giờ khúc ballad đã có đoạn mở đầu đàng hoàng.",
        "riddle": {
          "text": "Hai tháp chuông gạch đỏ giữ tiếng vọng đẹp nhất của quảng trường. Mấy chú bồ câu chỉ giả bộ bắt nhịp thôi. Đến nơi nó vọng lại.",
        },
        "scope": "solo",
        "steps": [
          {
            "locationId": "cathedral",
            "type": "GO_TO",
          },
        ],
        "title": "Câu đố cho tiếng vọng",
      },
    ],
  },
  "vy": {
    "en": [
      {
        "description": "A new lantern needs a name and a dramatic backstory. Hang it in the alley, ask Cô Hoa for the name, then send the announcement postcard to Thao.",
        "giverNpcId": "vy",
        "payoff": "Alex photographed Pho Moon at dusk? A lantern with its own backstory and a portrait. Immortal.",
        "scope": "solo",
        "steps": [
          {
            "locationId": "alley",
            "type": "GO_TO",
          },
          {
            "npcId": "hoa",
            "type": "TALK_TO",
          },
          {
            "itemId": "postcard",
            "npcId": "thao",
            "type": "DELIVER",
          },
        ],
        "title": "A lantern needs a name",
        "twist": {
          "line": "Hoa: I named it "Pho Moon." Thao hates puns, so send the card to Alex — he will photograph it.",
          "step": {
            "itemId": "postcard",
            "npcId": "alex",
            "type": "DELIVER",
          },
        },
      },
      {
        "description": "Take this cà phê to Mai for the lantern crew. Tell her it is for "Phở Moon", the lantern that survived last year's drizzle. A hero deserves caffeine.",
        "giverNpcId": "vy",
        "payoff": "Mai toasted Phở Moon with the coffee. The lantern has never felt so seen.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "coffee",
            "npcId": "mai",
            "type": "DELIVER",
          },
        ],
        "title": "Coffee for the lantern crew",
      },
      {
        "description": "Visit the food alley and look for a welcoming evening corner.",
        "giverNpcId": "vy",
        "scope": "solo",
        "steps": [
          {
            "locationId": "alley",
            "type": "GO_TO",
          },
        ],
        "title": "An evening walk",
      },
    ],
    "vi": [
      {
        "description": "Chiếc lồng đèn mới cần một cái tên và một câu chuyện thật kịch tính. Treo nó trong hẻm, nhờ Cô Hoa đặt tên, rồi gửi tấm bưu thiếp thông báo cho Thảo.",
        "giverNpcId": "vy",
        "payoff": "Alex chụp "Phở Moon" lúc chạng vạng hả? Một chiếc lồng đèn có cả câu chuyện lẫn tấm chân dung. Bất tử luôn.",
        "scope": "solo",
        "steps": [
          {
