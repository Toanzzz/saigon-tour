        ],
        "title": "Herbs on the way to the park",
      },
    ],
    "vi": [
      {
        "description": "Nhanh — bạn — mang — trái chuối — này cho — bác Ba — bên sông. Mà giữ nhịp, đừng — chậm lại, không thì — tính là — ngày nghỉ. Chạy, chạy.",
        "giverNpcId": "river-jogger",
        "payoff": "Bác Ba — nhận rồi — mà bạn — giữ nhịp hả? Vậy hôm nay — không phải — ngày nghỉ. Thở — giỏi lắm bạn.",
        "scope": "solo",
        "steps": [
          {
            "itemId": "banana",
            "npcId": "ba",
            "type": "DELIVER",
          },
        ],
        "title": "Giữ nhịp với trái chuối",
      },
      {
        "description": "Mang rau thơm này đến cho chị Linh ở công viên.",
        "giverNpcId": "river-jogger",
        "scope": "solo",
        "steps": [
          {
            "itemId": "herbs",
            "npcId": "linh",
            "type": "DELIVER",
          },
        ],
        "title": "Rau thơm trên đường ra công viên",
      },
    ],
  },
  "riverside-friends": {
    "en": [
      {
        "description": "Say hello to Linh in the park for the river neighbor, then return.",
        "giverNpcId": "riverside-friends",
        "scope": "solo",
        "steps": [
          {
            "npcId": "linh",
