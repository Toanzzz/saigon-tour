exports[`npc baseline > localized npc text is unchanged 1`] = `
{
  "alex": {
    "en": {
      "knowledge": [
        "The Opera House columns catch beautiful afternoon light.",
        "The cathedral and Central Post Office share a compact square.",
        "The riverfront viewpoint looks back toward the city skyline.",
      ],
      "name": "Alex",
      "role": "Visiting photographer",
    },
    "vi": {
      "knowledge": [
        "Hàng cột Nhà hát bắt nắng chiều rất đẹp.",
        "Nhà thờ và Bưu điện Trung tâm nằm quanh một quảng trường nhỏ.",
        "Điểm ngắm bên sông nhìn về đường chân trời thành phố.",
      ],
      "name": "Alex",
      "role": "Nhiếp ảnh gia đến thăm",
    },
  },
  "alley-diner": {
    "en": {
      "idleLine": "That last bite, bạn? Nine-point-four. Rich opening, clean finish, no notes.",
      "knowledge": [
        "I camp out in the food alley scoring every bowl like a judge.",
        "That broth was a nine-point-four — rich opening, strong finish.",
      ],
      "name": "Trang",
      "role": "Food enthusiast",
    },
    "vi": {
      "idleLine": "Miếng vừa rồi hả bạn? Chín phẩy tư. Mở vị đậm, hậu sạch, khỏi chê.",
      "knowledge": [
        "Mình ngồi lì trong hẻm ẩm thực, chấm điểm từng tô như giám khảo.",
        "Tô nước lèo đó được chín phẩy tư — mở vị đậm đà, hậu vị mạnh.",
      ],
      "name": "Trang",
      "role": "Người mê ẩm thực",
    },
  },
  "alley-vendor": {
    "en": {
      "idleLine": "Hello! I'm the alley cook. How is your walk today?",
      "knowledge": [
        "I spend my days around the food alley.",
        "A small favor helps neighbors get to know one another.",
      ],
      "name": "Mr. Loc",
      "role": "Alley cook",
    },
    "vi": {
      "idleLine": "Chào bạn! Mình là người nấu ăn trong hẻm. Hôm nay bạn đi dạo thế nào?",
      "knowledge": [
        "Mình hay ở quanh hẻm ẩm thực.",
        "Một việc nhỏ cũng giúp hàng xóm gần nhau hơn.",
      ],
      "name": "Chú Lộc",
      "role": "Người nấu ăn trong hẻm",
    },
  },
  "ba": {
    "en": {
      "knowledge": [
        "The river is a lovely place to slow down.",
        "Ben Thanh is the heart of the neighborhood.",
      ],
      "name": "Mr. Ba",
      "role": "Cyclo driver and storyteller",
    },
    "vi": {
      "knowledge": [
        "Bờ sông là nơi dễ chịu để chậm lại.",
        "Bến Thành là trái tim của khu phố.",
      ],
      "name": "Ông Ba",
      "role": "Người đạp xích lô và kể chuyện",
    },
  },
  "bread-vendor": {
    "en": {
      "idleLine": "Listen to that crust, bạn — a solid eighty decibels of crunch today.",
      "knowledge": [
        "A fresh bánh mì should snap loud enough to hear across the stall.",
        "I grade every loaf in crunch decibels; a quiet crust is a sad crust.",
      ],
      "name": "Mr. Binh",
      "role": "Sandwich vendor",
    },
    "vi": {
      "idleLine": "Nghe cái vỏ đó chưa bạn — hôm nay giòn tám chục đề-xi-ben luôn.",
      "knowledge": [
        "Ổ bánh mì tươi phải giòn rôm rốp nghe tới cuối sạp mới đạt.",
        "Chú chấm từng ổ bằng "đề-xi-ben độ giòn"; vỏ mềm là vỏ buồn.",
      ],
      "name": "Chú Bình",
      "role": "Người bán bánh mì",
    },
  },
  "coffee-friend": {
    "en": {
      "idleLine": "Hello! I'm the coffee regular. How is your walk today?",
      "knowledge": [
        "I spend my days around the market.",
        "A small favor helps neighbors get to know one another.",
      ],
      "name": "Duc",
      "role": "Coffee regular",
    },
    "vi": {
